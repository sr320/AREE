# Python
__pycache__/
*.pyc
.venv/
.venv_verify/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Generated outputs (regenerate via `make demo` / `aree` commands)
reports/evidence/
reports/meta_analysis/
reports/evidence_cards/
reports/manifests/
reports/top_candidates_summary.md

# OS
.DS_Store

# Quarto
docs/_site/
docs/.quarto/

# Nextflow runtime artifacts
.nextflow/
.nextflow.log*
workflows/*/work/
workflows/*/results/
workflows/*/report.html
workflows/*/timeline.html
workflows/*/trace.txt*
workflows/*/dag.dot

# Downloaded reference sources for crosswalk building (regenerate via `aree build-crosswalk`).
# The built crosswalk + provenance sidecar ARE committed; these raw inputs are not.
data/reference/crosswalk/_sources/

# Staged sequence data for raw_reanalysis studies (hundreds of GB). Usually a
# symlink to a data drive, so the pattern has no trailing slash.
# Sample sheets and checksummed FASTQ manifests ARE committed; reads are not.
data/raw
results/

# Dashboard data + copied evidence cards (regenerate via `aree build-dashboard` / `make dashboard`)
docs/dashboard/

# Genome/transcriptome bundles live on external storage; see docs/first_raw_reanalysis.md.
# No trailing slash: on most machines these are symlinks to a drive, and a
# pattern ending in / does not match a symlink.
data/reference/GCF_*

# Flat study indexes, generated from registry/studies/*.yaml and
# registry/demo_studies/*.yaml by `aree build-registry`.
# Not committed: study branches built in parallel would all conflict on them.
registry/study_registry.csv
registry/demo_study_registry.csv

# OrthoFinder intermediates (staged proteomes, DIAMOND results); the run's
# outputs under data/reference/orthogroups/<run_id>/ ARE committed.
data/reference/orthogroups/_work/

# KEGG-derived metabolite -> gene link table for real C. gigas evidence. Built
# locally by `aree build-metabolite-links`; NOT committed, because KEGG does not
# clearly grant redistribution of derived tables (docs/metabolite_gene_links.md).
# The simulated demo table (metabolite_gene_links_demo.*) IS committed.
data/mappings/metabolite_gene_links_mgigas.*
data/mappings/_sources/

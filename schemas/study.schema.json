{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aree.example.org/schemas/study.schema.json",
  "title": "AREE Study Registration",
  "description": "Schema for a single registered public dataset (registry/studies/*.yaml).",
  "type": "object",
  "required": [
    "study_id",
    "citation",
    "species",
    "genome_assembly",
    "assay_type",
    "analysis_mode",
    "comparisons",
    "data_availability",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique, stable identifier for this study within AREE. Must match the filename stem."
    },
    "simulated": {
      "type": "boolean",
      "default": false,
      "description": "True if this study record uses synthetic/demo data rather than a real public dataset."
    },
    "accessions": {
      "type": "object",
      "description": "External identifiers. At least one should be present for non-simulated studies.",
      "additionalProperties": false,
      "properties": {
        "doi": {"type": ["string", "null"]},
        "bioproject": {"type": ["string", "null"]},
        "geo": {"type": ["string", "null"]},
        "sra": {"type": ["string", "null"]},
        "ena": {"type": ["string", "null"]},
        "proteomexchange": {"type": ["string", "null"]},
        "other": {"type": ["string", "null"]}
      }
    },
    "citation": {"type": "string", "description": "Full citation string for the source publication/dataset."},
    "species": {"type": "string", "description": "Scientific name, e.g. Crassostrea gigas."},
    "strain_or_population": {
      "type": ["string", "null"],
      "description": "Strain, population, family, or breeding line where available."
    },
    "genome_assembly": {"type": "string", "description": "Reference genome assembly identifier/version."},
    "annotation_version": {"type": ["string", "null"], "description": "Genome annotation version, if applicable."},
    "assay_type": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "One or more assay type ontology term IDs (registry/controlled_vocabularies/assay_types.yaml)."
    },
    "analysis_mode": {
      "type": "string",
      "enum": ["raw_reanalysis", "processed_results_harmonization"],
      "description": "Whether AREE reanalyzes raw data or harmonizes already-processed results for this study."
    },
    "platform": {"type": ["string", "null"], "description": "Sequencing or instrument platform."},
    "data_availability": {
      "type": "object",
      "required": ["raw_data_available", "processed_data_available", "status"],
      "additionalProperties": false,
      "properties": {
        "raw_data_available": {"type": "boolean"},
        "processed_data_available": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["available", "restricted", "embargoed", "unavailable"]
        },
        "access_notes": {"type": ["string", "null"]}
      }
    },
    "qc_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "passed", "passed_with_warnings", "failed"],
      "default": "not_started"
    },
    "analysis_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "harmonized", "meta_analyzed"],
      "default": "not_started"
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "description": "Each treatment-vs-control comparison reported by this study.",
      "items": {
        "type": "object",
        "required": [
          "comparison_id", "tissue", "life_stage", "stressor_original", "stressor_standardized",
          "control_condition", "treatment_condition", "phenotype", "phenotype_direction",
          "sample_size", "biological_replicates"
        ],
        "additionalProperties": false,
        "properties": {
          "comparison_id": {"type": "string"},
          "tissue": {"type": "string", "description": "Tissue ontology term ID."},
          "life_stage": {"type": "string", "description": "Life stage ontology term ID."},
          "stressor_original": {"type": "string", "description": "Free-text stressor/treatment description as reported by the source study."},
          "stressor_standardized": {"type": "string", "description": "Stressor ontology term ID."},
          "exposure_intensity": {"type": ["string", "null"]},
          "exposure_duration": {"type": ["string", "null"]},
          "exposure_timing": {"type": ["string", "null"]},
          "control_condition": {"type": "string"},
          "treatment_condition": {"type": "string"},
          "phenotype": {"type": "string", "description": "Phenotype ontology term ID."},
          "phenotype_direction": {
            "type": "string",
            "enum": ["increase", "decrease", "no_change", "mixed", "not_applicable"]
          },
          "phenotype_unit": {"type": ["string", "null"]},
          "resilience_classification": {
            "type": "string",
            "enum": ["resilience", "stress_response", "disease", "exposure_only"],
            "description": "Must agree with the phenotype ontology's resilience_relevance unless explicitly overridden with a note."
          },
          "sample_size": {"type": "integer", "minimum": 0},
          "biological_replicates": {"type": "integer", "minimum": 0},
          "results_file": {
            "type": ["string", "null"],
            "description": "Relative path to the processed results file for this comparison, if analysis_mode is processed_results_harmonization."
          }
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Quality flag ontology term IDs."
    },
    "limitations": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "required": ["registered_by", "date_registered"],
      "additionalProperties": false,
      "properties": {
        "registered_by": {"type": "string"},
        "date_registered": {"type": "string", "format": "date"},
        "curation_notes": {"type": ["string", "null"]},
        "source_links": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}

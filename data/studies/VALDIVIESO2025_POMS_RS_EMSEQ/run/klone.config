/*
 * VALDIVIESO2025_POMS_RS_EMSEQ :: Klone run settings (re-run, 2026-11).
 *
 * Passed with -c after config/VALDIVIESO2025_POMS_RS_EMSEQ.config, and before
 * the per-comparison config that run_comparisons.sbatch writes for each
 * comparison. Reconstructed from the first Klone run (2026-10-20..22, draft
 * PR #103), whose run-only configs lived on /gscratch/scrubbed and were
 * purged with its outputs. The settings are those recorded in the PR:
 *   - align_chunk_pairs = 20000000 (chunked Bismark on ckpt partitions)
 *   - extractor_args from M-bias on a 400k-pair test of ERR13913462
 *   - limma on gene units, blocked by population
 * The limma coverage settings follow CIBNOR2021_HEAT_RRSS.
 *
 * BLOCKING. Each population contributes one resistant and one susceptible
 * animal, so in the four R-vs-S comparisons population pairs the animals; in
 * the four T1-vs-T0 comparisons the phenotype class is fixed, so population
 * identifies the single animal sampled before and after. block_by =
 * 'population' is therefore the right pairing for all eight comparisons.
 */

params {
    // Reference kept on group storage (not scrubbed, which purges at 21 days).
    genome_fasta   = "/gscratch/srlab/${System.getenv('USER')}/aree/reference/GCF_963853765.1/genomic.fna"
    annotation_gtf = "/gscratch/srlab/${System.getenv('USER')}/aree/reference/GCF_963853765.1/genomic.gtf"

    methylation {
        align_chunk_pairs = 20000000
        extractor_args    = '--ignore 2 --ignore_r2 20 --ignore_3prime 1 --ignore_3prime_r2 1'

        dmr_engine        = 'limma'
        dmr_features      = 'genes'
        min_coverage      = 1
        unit_min_coverage = 10
        tile_min_cpgs     = 10

        design_sheet = 'data/studies/VALDIVIESO2025_POMS_RS_EMSEQ/samplesheet.tsv'
        block_by     = 'population'
    }

    // Outputs stay symlinks into the work dir (BAMs are hundreds of GB), so
    // run_comparisons.sbatch copies the kept outputs off scrubbed with
    // harvest.sh after every comparison. Do not rely on --outdir.
    publish_mode = 'symlink'
}

process {
    // The study config's workstation time limits would otherwise win over
    // -profile klone; ckpt tasks must fit 4 h 45 m.
    withName: 'FASTQC|COUNT_READ_PAIRS|TRIM_ALIGN_CHUNK|MERGE_DEDUP_CHUNKS|BISMARK_.*|COVERAGE_FILTER|DMR_.*' { time = '4h 45m' }
}

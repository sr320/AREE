/*
 * DECICOMP2025_POMS_AGE_EMSEQ :: Klone run settings (2026-11).
 *
 * Passed with -c after config/DECICOMP2025_POMS_AGE_EMSEQ.config, and before
 * the per-comparison config that run_comparisons.sbatch writes for each
 * comparison. Same approach as VALDIVIESO2025_POMS_RS_EMSEQ/run/klone.config
 * (same laboratory, kit and sequencer): chunked Bismark on ckpt partitions,
 * limma on gene units.
 *
 * BLOCKING. Every arm holds 6 oysters from each of families F14R and H2D, so
 * family is a block that holds both arms of every comparison. block_by =
 * 'family' fits ~ family + treatment on the 24 individuals, which removes
 * the family difference the study config notes as unmodeled variance. The
 * individuals are the replicates; no replicate_unit is set.
 *
 * EXTRACTOR ARGS. From the M-bias check of 2026-11-26 on the first 1 M read
 * pairs of ERR15996532 (mbias_check_2026-11-26.md, run/mbias_check.sbatch).
 */

params {
    // Reference kept on group storage (not scrubbed, which purges at 21 days).
    genome_fasta   = "/gscratch/srlab/${System.getenv('USER')}/aree/reference/GCF_963853765.1/genomic.fna"
    annotation_gtf = "/gscratch/srlab/${System.getenv('USER')}/aree/reference/GCF_963853765.1/genomic.gtf"

    methylation {
        align_chunk_pairs = 20000000
        extractor_args    = '--ignore 2 --ignore_r2 12 --ignore_3prime 1 --ignore_3prime_r2 1'

        dmr_engine        = 'limma'
        dmr_features      = 'genes'
        min_coverage      = 1
        unit_min_coverage = 10
        tile_min_cpgs     = 10

        design_sheet = 'data/studies/DECICOMP2025_POMS_AGE_EMSEQ/samplesheet.tsv'
        block_by     = 'family'
    }

    // Outputs stay symlinks into the work dir (BAMs are hundreds of GB), so
    // run_comparisons.sbatch copies the kept outputs off scrubbed with
    // harvest.sh after every comparison. Do not rely on --outdir.
    publish_mode = 'symlink'
}

process {
    // The study config's workstation time limits would otherwise win over
    // -profile klone; ckpt tasks must fit 4 h 45 m.
    withName: 'FASTQC|COUNT_READ_PAIRS|TRIM_ALIGN_CHUNK|MERGE_DEDUP_CHUNKS|BISMARK_.*|COVERAGE_FILTER|DMR_.*' { time = '4h 45m' }
}

/*
 * AREE :: run configuration for DOU2020_EMERSION (PRJNA621633)
 *
 * Manila clam (Ruditapes philippinarum), wild, Golden Pebble Beach (Dalian),
 * whole soft body. Full-length paired-end libraries (HiSeq 2500,
 * library_selection RANDOM), so the standard RNA-seq path applies: no
 * tag_seq, Salmon length correction and DESeq2 length offsets on.
 *
 * The sample sheet's `condition` is the group code from the sample aliases:
 * Con = control (immersed), AE = aerial exposure, RE = re-immersion after
 * aerial exposure; n = 3 per group, one BioSample per library.
 *
 * Primary comparison (meta_analysis_primary in the study YAML):
 *
 *   nextflow run workflows/rnaseq -config config/DOU2020_EMERSION.config \
 *     -profile local,workstation
 *
 * Secondary comparison (after re-immersion):
 *
 *   nextflow run workflows/rnaseq -config config/DOU2020_EMERSION.config \
 *     -profile local,workstation --comparison_id reimmersion_vs_control \
 *     --control_level Con --treatment_level RE
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA621633 --study DOU2020_EMERSION \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<treatment>Con|AE|RE)_(?P<rep>[123])$' \
 *     --condition-attribute treatment --attribute isolation_source \
 *     --attribute tissue --library-strategy RNA-Seq \
 *     --out data/studies/DOU2020_EMERSION
 *
 * The reference bundle comes from `aree fetch-reference --assembly GCF_026571515.1`
 * (docs/reference_bundles.md), shared with the other Manila clam studies.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'DOU2020_EMERSION'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_026571515.1'
        annotation_version = 'GCF_026571515.1-RS_2023_10'
        processed_results  = null
    }

    comparison_id = 'emersion_vs_control'

    sample_sheet = 'data/studies/DOU2020_EMERSION/samplesheet.tsv'

    control_level   = 'Con'
    treatment_level = 'AE'

    // FASTQ are not committed (31.3 GB for all 9 runs). Verify against ENA's
    // MD5s in data/studies/DOU2020_EMERSION/fastq_manifest.tsv.
    reads = 'data/raw/DOU2020_EMERSION/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_026571515.1/rna.fna'
    gtf              = 'data/reference/GCF_026571515.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_026571515.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/DOU2020_EMERSION'
}

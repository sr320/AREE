/*
 * AREE :: run configuration for CLARK2021_HEAT_GREENLAND (PRJEB41447)
 *
 * Full-length paired-end RNA-seq (Illumina HiSeq 2500, PE150, Novogene), so the
 * standard path applies: no tag_seq. Reads map to the RefSeq Mytilus edulis
 * annotation (xbMytEdul2.2, GCF_963676685.1). The study is in the hybridizing
 * M. edulis complex and carries species_assignment_unverified; see
 * registry/studies/CLARK2021_HEAT_GREENLAND.yaml.
 *
 * The prespecified primary comparison is set below (32 C heat shock vs subtidal
 * controls). For the others:
 *   --comparison_id heat_32c_vs_22c \
 *     --control_level collected_from_outer_fjord_warmed_to_22_degrees \
 *     --treatment_level collected_from_outer_fjord_warmed_to_32_degrees
 *   --comparison_id inner_fjord_warm_day_vs_subtidal_control \
 *     --control_level collected_from_outer_fjord_none \
 *     --treatment_level collected_from_inner_fjord_on_warm_day_none
 *
 *   nextflow run workflows/rnaseq -config config/CLARK2021_HEAT_GREENLAND.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJEB41447 --study CLARK2021_HEAT_GREENLAND \
 *     --condition-attribute "environmental history" --condition-attribute stimulus \
 *     --library-strategy RNA-Seq
 *
 * The reference bundle comes from `aree fetch-reference --assembly xbMytEdul2.2`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'CLARK2021_HEAT_GREENLAND'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963676685.1'
        annotation_version = 'GCF_963676685.1-RS_2025_02'
        processed_results  = null
    }

    // Prespecified primary comparison (meta_analysis_primary in the study YAML).
    comparison_id = 'heat_32c_vs_subtidal_control'

    sample_sheet = 'data/studies/CLARK2021_HEAT_GREENLAND/samplesheet.tsv'

    // Condition levels combine the BioSample attributes "environmental history" and "stimulus".
    control_level   = 'collected_from_outer_fjord_none'
    treatment_level = 'collected_from_outer_fjord_warmed_to_32_degrees'

    // FASTQ are not committed (84.9 GB for all 24 libraries; only registered
    // comparisons' libraries need staging). Verify against ENA's MD5s in
    // data/studies/CLARK2021_HEAT_GREENLAND/fastq_manifest.tsv.
    reads = 'data/raw/CLARK2021_HEAT_GREENLAND/ERR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963676685.1/rna.fna'
    gtf              = 'data/reference/GCF_963676685.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963676685.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/CLARK2021_HEAT_GREENLAND'
}

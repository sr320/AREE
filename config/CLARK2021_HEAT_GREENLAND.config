/*
 * AREE :: run configuration for CLARK2021_HEAT_GREENLAND (PRJEB41447)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/CLARK2021_HEAT_GREENLAND.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJEB41447 --study CLARK2021_HEAT_GREENLAND --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/CLARK2021_HEAT_GREENLAND/samplesheet.tsv'
    reads        = 'data/raw/CLARK2021_HEAT_GREENLAND/*_{1,2}.fastq.gz'
    outdir       = 'results/CLARK2021_HEAT_GREENLAND'
}

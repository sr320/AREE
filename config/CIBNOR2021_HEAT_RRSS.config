/*
 * AREE :: run configuration for CIBNOR2021_HEAT_RRSS (PRJNA690951)
 *
 * First real methylation study: WGBS of gill from 2 thermal-resistant (RR)
 * and 2 thermal-susceptible (SS) families, 3 libraries per family, all sampled
 * after 30 d of a daily 26-34 C oscillating challenge. One comparison:
 *
 *   nextflow run workflows/methylation \
 *     -config config/CIBNOR2021_HEAT_RRSS.config \
 *     -profile local,workstation
 *
 * (comparison_id is fixed below; there is only one comparison.)
 *
 * The sample sheets and FASTQ manifest are generated, not hand-written. All 12
 * libraries share one BioSample, so the design is parsed from experiment_title:
 *
 *   aree fetch-samplesheet --bioproject PRJNA690951 \
 *     --study CIBNOR2021_HEAT_RRSS \
 *     --label-field experiment_title \
 *     --label-pattern '(?P<phenotype_class>RR|SS)(?P<family>\d+)-R(?P<replicate>\d+)$' \
 *     --condition-attribute phenotype_class \
 *     --attribute family --attribute replicate --attribute tissue --attribute temp \
 *     --methylkit-levels SS RR
 *
 * NOT YET RUNNABLE AS A VALID ANALYSIS. DMR_METHYLKIT fits RR vs SS with no
 * family term, so it would treat 6 vs 6 libraries as independent when the
 * phenotype is assigned per family (2 vs 2). See the study YAML limitations.
 * Model family, or aggregate to family level, before computing results that
 * enter a pool.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    // AREE reanalyzes against its current reference, matching the other
    // raw_reanalysis studies and the identifier crosswalk. Bismark needs the
    // genome FASTA, which is not yet staged next to rna.fna/genomic.gtf.
    genome_assembly = 'GCF_963853765.1'
    genome_fasta    = 'data/reference/GCF_963853765.1/genomic.fna'
    annotation_gtf  = 'data/reference/GCF_963853765.1/genomic.gtf'

    // FASTQ are not committed (~129 GB). Stage on blue-block via data/raw and
    // verify against data/studies/CIBNOR2021_HEAT_RRSS/fastq_manifest.tsv MD5s.
    reads = 'data/raw/CIBNOR2021_HEAT_RRSS/SRR*_{1,2}.fastq.gz'

    methylation {
        study_id          = 'CIBNOR2021_HEAT_RRSS'
        comparison_id     = 'rr_vs_ss_day30_oscillating_heat'
        processed_results = null

        // SS = 0 (reference), RR = 1, keyed by run accession.
        sample_sheet = 'data/studies/CIBNOR2021_HEAT_RRSS/methylkit_samplesheet.csv'
    }

    outdir = 'results/methylation/CIBNOR2021_HEAT_RRSS'

    // Every methylation module publishes, including trimmed reads (~129 GB),
    // the Bismark index, and BAMs. results/ is on the internal disk, which is
    // near full: symlink into the work dir on the external SSD, never copy.
    publish_mode = 'symlink'
}

process {
    // 12 HiSeq 2000 PE libraries, 54-73 M read pairs each (~30x of a ~0.6 Gb
    // genome). Bismark runs several bowtie2 instances per --multicore.
    withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '32 GB'; time = '6h'  }
    withName: 'BISMARK_ALIGN'                 { cpus = 12; memory = '48 GB'; time = '24h' }
    withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '16 GB'; time = '6h'  }
    withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 8;  memory = '16 GB'; time = '12h' }
    withName: 'TRIM_GALORE'                   { cpus = 4;  memory = '8 GB';  time = '4h'  }
    withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '32 GB'; time = '6h'  }
}

// AREE shared Nextflow base configuration
//
// STATUS: scaffold. This file defines default resource requests, error
// strategy, and reporting toggles shared by all four assay workflows
// (rnaseq, methylation, proteomics, metabolomics). It has not been tuned
// against real workloads because no raw data / compute budget was available
// in this build — treat the values below as reasonable placeholders for a
// small/medium aquaculture dataset, not benchmarked defaults.
//
// Each workflow's own nextflow.config does:
//   includeConfig "${projectDir}/../../config/base.config"
// (path is relative to workflows/<assay>/nextflow.config)

params {
    // Shared, assay-agnostic defaults. Individual workflows override/extend.
    outdir              = 'results'
    publish_mode        = 'copy'      // 'copy' | 'symlink'
    max_cpus            = 8
    max_memory          = '32.GB'
    max_time            = '24.h'
    tracedir            = "${params.outdir}/pipeline_info"
}

process {
    cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Per-label overrides. Assay-specific process blocks assign these labels
    // (e.g. `label 'process_high'` on an alignment step) so resourcing can be
    // tuned per workflow without editing shared config.
    withLabel: process_low {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { 8.GB  * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

profiles {
    // Local workstation with the two external drives described in
    // docs/first_raw_reanalysis.md ("Storage layout"). Combine with an
    // executor profile, e.g. `-profile local,workstation`.
    //
    //   ST5, the Samsung T5 (HFS+ SSD, ~450 MB/s) -> Nextflow work directory.
    //       Task folders are many small files and symlinks; keep them on the
    //       SSD. The volume was renamed from "Samsung T5" on 2026-10-12: no
    //       path a tool sees may contain a space (see the docs page).
    //   blue-block (APFS HDD, ~140 MB/s, 4 TB) -> raw FASTQs and reference
    //       bundles, reached through the data/raw and data/reference symlinks.
    //
    // Results stay under the repository's results/ (APFS) so the harmonize
    // step's relative paths keep working. Neither drive is exFAT: Quarto's
    // report cleanup and Salmon's publishDir both fail there.
    //
    // On any other machine, point AREE_WORKDIR at that machine's fast local
    // disk instead of editing this file: e.g. `export AREE_WORKDIR=/scratch/aree/work`.
    // Several study runs on one machine can share a work directory; Nextflow
    // keys task folders by hash.
    workstation {
        workDir = System.getenv('AREE_WORKDIR') ?: '/Volumes/ST5/aree/work'
    }

    // UW Hyak Klone, Slurm on the preemptible checkpoint partition. Combine
    // with the container profile: `-profile apptainer,klone`. Run the
    // Nextflow head job itself on a non-preemptible partition (see
    // docs/running_on_klone.md); only the tasks go to ckpt.
    //
    // ckpt jobs can be preempted and requeued at any time, and Hyak documents
    // a cap of a few hours per CPU job, so every task here is kept under
    // 4 h 45 min and retried on any failure. Deep methylation libraries need
    // methylation.align_chunk_pairs (e.g. 20000000) to keep Bismark tasks
    // short. Environment overrides:
    //   AREE_WORKDIR         work directory (default /gscratch/scrubbed/$USER/aree/work)
    //   AREE_SLURM_ACCOUNT   Slurm account for ckpt jobs (default srlab)
    //   AREE_SLURM_QUEUE     partition (default ckpt-all)
    //   AREE_APPTAINER_CACHEDIR  image cache on a shared filesystem (default
    //                        /gscratch/scrubbed/$USER/aree/apptainer-cache)
    klone {
        workDir = System.getenv('AREE_WORKDIR') ?: "/gscratch/scrubbed/${System.getenv('USER')}/aree/work"
        // Not APPTAINER_CACHEDIR: Hyak sets it to node-local /tmp inside
        // jobs, where compute nodes cannot see the pulled images.
        apptainer.cacheDir = System.getenv('NXF_APPTAINER_CACHEDIR') ?: System.getenv('AREE_APPTAINER_CACHEDIR') ?: "/gscratch/scrubbed/${System.getenv('USER')}/aree/apptainer-cache"
        executor {
            name            = 'slurm'
            queueSize       = 300
            submitRateLimit = '10/1sec'
            pollInterval    = '1 min'
        }
        process {
            executor       = 'slurm'
            queue          = System.getenv('AREE_SLURM_QUEUE') ?: 'ckpt-all'
            clusterOptions = "--account=${System.getenv('AREE_SLURM_ACCOUNT') ?: 'srlab'}"
            errorStrategy  = 'retry'
            maxRetries     = 6
            time           = '4h 45m'
            cpus           = 2
            memory         = '8 GB'

            // The base labels allow up to 12 h x attempt; cap every task.
            withLabel: 'process_low|process_medium|process_high' { time = '4h 45m' }

            withName: 'FASTQC'                        { cpus = 4;  memory = '8 GB'  }
            withName: 'TRIM_GALORE'                   { cpus = 8;  memory = '16 GB' }
            withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '32 GB' }
            withName: 'SPLIT_FASTQ_PAIRS'             { cpus = 4;  memory = '8 GB'  }
            // --multicore = cpus / 3 = 4 Bismark instances per chunk.
            withName: 'BISMARK_ALIGN_CHUNK'           { cpus = 12; memory = '40 GB' }
            withName: 'BISMARK_ALIGN'                 { cpus = 12; memory = '40 GB' }
            withName: 'BISMARK_MERGE_CHUNKS'          { cpus = 2;  memory = '4 GB'  }
            withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '32 GB' }
            withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 16; memory = '32 GB' }
            withName: 'COVERAGE_FILTER'               { cpus = 1;  memory = '4 GB'  }
            withName: 'DMR_POOLED_TILES'              { cpus = 4;  memory = '64 GB' }
            withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '64 GB' }
        }
    }
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace.txt"
    fields    = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem'
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_dag.html"
}

manifest {
    author          = 'AREE contributors'
    homePage        = 'https://github.com/PLACEHOLDER_ORG/AREE'
    description     = 'Aquaculture Resilience Evidence Engine — assay reanalysis scaffolds'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

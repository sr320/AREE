/*
 * AREE :: run configuration for PROESTOU2020_DERMO_FAM (PRJNA590205)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/PROESTOU2020_DERMO_FAM.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA590205 --study PROESTOU2020_DERMO_FAM --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/PROESTOU2020_DERMO_FAM/samplesheet.tsv'
    reads        = 'data/raw/PROESTOU2020_DERMO_FAM/*_{1,2}.fastq.gz'
    outdir       = 'results/PROESTOU2020_DERMO_FAM'
}

/*
 * AREE :: run configuration for LSU2024_HYPOX_POP (PRJNA1153018)
 *
 * Eastern oyster (Crassostrea virginica) gill, hypoxia vs control in a more
 * hypoxia-tolerant Texas (TX) and a less tolerant Louisiana (LA) population,
 * sampled on days 1, 2 and 3; 4 oysters per population x treatment x day,
 * 48 single-end 101 bp libraries. Louisiana State University deposit, public
 * 2024-08-29; no publication found (2026-11-27).
 *
 * The libraries are 3' Tag-seq (QuantSeq FWD signature: ~43% of reads in a
 * 20,000-read sample of SRR30420622 carry a run of >= 15 A, none start with
 * poly-T; ENA gives no protocol), so --single_end and --tag_seq.
 *
 * Four prespecified comparisons; condition = population_treatment. Day is
 * fitted as a covariate in every one (each arm has 4 oysters on each day).
 * The default below is the exposure_response primary:
 *
 *   AREE_WORKDIR=/Volumes/Monarch/AREE/work nextflow run workflows/rnaseq \
 *     -config config/LSU2024_HYPOX_POP.config -profile local,workstation -resume
 *
 * The other three override the levels and id (and --outdir):
 *
 *   --comparison_id tx_hypoxia_vs_control \
 *     --control_level TX_control --treatment_level TX_hypoxia
 *   --comparison_id tx_vs_la_hypoxia \
 *     --control_level LA_hypoxia --treatment_level TX_hypoxia
 *   --comparison_id tx_vs_la_control \
 *     --control_level LA_control --treatment_level TX_control
 *
 * The BioSamples carry the design only in `isolate` (e.g. "LA day1
 * hypoxia_3"); design.tsv splits it into columns:
 *
 *   aree fetch-samplesheet --bioproject PRJNA1153018 --study LSU2024_HYPOX_POP \
 *     --design-table data/studies/LSU2024_HYPOX_POP/design.tsv --design-join isolate \
 *     --design-source "<as in ena_provenance.json>" \
 *     --condition-attribute population --condition-attribute treatment \
 *     --attribute day --attribute replicate --attribute isolate --attribute tissue
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LSU2024_HYPOX_POP'
        // Left null so --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_053477285.1'
        annotation_version = 'GCF_053477285.1-RS_2025_12'
        processed_results  = null
    }

    comparison_id = 'la_hypoxia_vs_control'

    sample_sheet = 'data/studies/LSU2024_HYPOX_POP/samplesheet.tsv'

    control_level   = 'LA_control'
    treatment_level = 'LA_hypoxia'

    covariates = 'day'

    single_end = true
    tag_seq    = true

    // FASTQ are not committed (13.8 GB for all 48 runs); stage and verify
    // them with `aree fetch-fastq --study LSU2024_HYPOX_POP`.
    reads = 'data/raw/LSU2024_HYPOX_POP/SRR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_053477285.1/rna.fna'
    gtf              = 'data/reference/GCF_053477285.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_053477285.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/LSU2024_HYPOX_POP/la_hypoxia_vs_control'
}

process {
    // 48 HiSeq 2500 single-end 101 bp QuantSeq libraries, 5-8 M reads.
    // Sized for Hete (8 cores, 16 GB).
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 4;  memory = '8 GB';  time = '1h'  }
    withName: 'TRIM_FASTP'   { cpus = 2;  memory = '4 GB';  time = '1h'  }
    withName: 'FASTQC'       { cpus = 1;  memory = '2 GB';  time = '1h'  }
}

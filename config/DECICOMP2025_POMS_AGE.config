/*
 * AREE :: run configuration for DECICOMP2025_POMS_AGE (MetaboLights MTBLS13463)
 *
 * NOT RUNNABLE YET. The metabolomics workflow's raw_reanalysis mode takes an
 * aligned feature-by-sample intensity table, not vendor raw files. This study
 * deposits only Agilent MassHunter .d files (targeted dynamic MRM, three
 * platforms), and its MetaboLights MAFs contain no abundance values (see
 * data/studies/DECICOMP2025_POMS_AGE/metabolights_provenance.json).
 *
 * To run it, first produce one integrated peak-area table per platform:
 *   - ask the submitters to complete the MAFs, or
 *   - integrate the MRM transitions from the raw files (e.g. msconvert to
 *     mzML, then Skyline with the submitters' transition list) and record
 *     that step's version and parameters.
 * Then set raw_feature_table below and run once per comparison:
 *
 *   nextflow run workflows/metabolomics -config config/DECICOMP2025_POMS_AGE.config -profile local
 *
 * The sample sheet's `condition` column holds age4mo / age16mo / age28mo.
 * Subset it to the two arms of each comparison, with age4mo as control, and
 * keep `family` as a blocking factor.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/DECICOMP2025_POMS_AGE'

    metabolomics {
        raw_feature_table = null   // not yet available: see header
        sample_sheet      = 'data/studies/DECICOMP2025_POMS_AGE/samplesheet.tsv'
        study_id          = 'DECICOMP2025_POMS_AGE'
        comparison_id     = 'age28mo_vs_age4mo_basal'
    }
}

/*
 * AREE :: run configuration for PAYTON2017_HAB_AMINUTUM (PRJEB18614)
 *
 * Payton et al. 2017, Sci Rep 7:3480 (doi:10.1038/s41598-017-03797-4);
 * ArrayExpress E-MTAB-5345. Adult gill, 6 days on the paralytic-shellfish-
 * toxin producer Alexandrium minutum (HAB, ~400 cells/mL) vs the non-toxic
 * dinoflagellate Heterocapsa triquetra, 3 tanks per diet; gill of 6 oysters
 * pooled per diet every 4 h for 52 h (13 libraries per diet), each library
 * sequenced on two lanes (52 runs).
 *
 *   nextflow run workflows/rnaseq -config config/PAYTON2017_HAB_AMINUTUM.config \
 *     -profile local,workstation
 *
 * Every run gets its own sample_id (the run accession), and
 * replicate_unit = sample_accession sums each library's two lanes before
 * DESeq2, so the replicates are the 13 libraries per diet, not 26 lanes.
 *
 *   aree fetch-samplesheet --bioproject PRJEB18614 --study PAYTON2017_HAB_AMINUTUM \
 *     --label-field run_accession --label-pattern '^(?P<run>ERR\d+)$' \
 *     --condition-attribute "growth condition" --attribute "organism part"
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'PAYTON2017_HAB_AMINUTUM'
        // Null so --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'alexandrium_vs_heterocapsa_6d'

    sample_sheet = 'data/studies/PAYTON2017_HAB_AMINUTUM/samplesheet.tsv'

    control_level   = 'Heterocapsa_triquetra'
    treatment_level = 'Alexandrium_minutum'

    // Two sequencing lanes per library: sum them, so a library is one replicate.
    replicate_unit  = 'sample_accession'

    // FASTQ are not committed. Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/PAYTON2017_HAB_AMINUTUM/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    reads = 'data/raw/PAYTON2017_HAB_AMINUTUM/ERR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/PAYTON2017_HAB_AMINUTUM'
}

process {
    // 52 HiSeq 2500 2x100 runs (26 libraries x 2 lanes). Sized for a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

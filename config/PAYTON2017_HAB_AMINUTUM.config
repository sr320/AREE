/*
 * AREE :: run configuration for PAYTON2017_HAB_AMINUTUM (PRJEB18614)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/PAYTON2017_HAB_AMINUTUM.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJEB18614 --study PAYTON2017_HAB_AMINUTUM --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/PAYTON2017_HAB_AMINUTUM/samplesheet.tsv'
    reads        = 'data/raw/PAYTON2017_HAB_AMINUTUM/*_{1,2}.fastq.gz'
    outdir       = 'results/PAYTON2017_HAB_AMINUTUM'
}

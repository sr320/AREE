/*
 * AREE :: run configuration for LUTIER2022_OA_TIPPING (PRJNA735889)
 *
 * Complete and parameterized, but NOT RUNNABLE AS A VALID CONTRAST YET. The
 * prespecified comparison pools several tanks per arm and needs tank, not
 * oyster, as the unit of replication. DIFFERENTIAL_EXPRESSION_DESEQ2 accepts
 * one condition level per arm and fits ~condition on individual libraries.
 * See the header and limitations in registry/studies/LUTIER2022_OA_TIPPING.yaml.
 * Quantification (FASTQC -> fastp -> Salmon) does not depend on that and can
 * run now.
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA735889 --study LUTIER2022_OA_TIPPING \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<tank>\d+)(?P<oyster>[A-E])(?P<library_suffix>bis)?$' \
 *     --condition-attribute treatment --condition-attribute tank \
 *     --attribute oyster --attribute library_suffix --attribute replicate \
 *     --attribute "dev stage" --attribute tissue --attribute growth_protocol
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LUTIER2022_OA_TIPPING'
        comparison_id      = 'ph_le6_7_vs_ph_ge7_6_23d'
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    // One condition level per tank: pHT_<pH>_<tank>, e.g. pHT_6_5_bis_15.
    sample_sheet = 'data/studies/LUTIER2022_OA_TIPPING/samplesheet.tsv'

    // Prespecified arms (meta_analysis_primary in the study YAML):
    //   control   = pHT_7_8_3, pHT_7_7_5, pHT_7_6_8
    //   treatment = pHT_6_7_7, pHT_6_6_16, pHT_6_5_9, pHT_6_5_bis_15
    // Left null on purpose: the module takes a single level per arm, and
    // setting one tank per arm here would run a pH-confounded-with-tank
    // contrast with oyster-level standard errors.
    control_level   = null
    treatment_level = null

    // FASTQ are not committed (347 GB for all 76 runs; the 35 libraries in the
    // prespecified arms are the minimum to stage). Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/LUTIER2022_OA_TIPPING/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    // Do not select runs by ENA library_strategy: 31 RNA-seq runs are
    // mislabelled AMPLICON.
    reads = 'data/raw/LUTIER2022_OA_TIPPING/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/LUTIER2022_OA_TIPPING'
}

process {
    // 76 NovaSeq 2x150 libraries, 8.5-61.5 M read pairs each.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '3h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '3h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '2h'  }
}

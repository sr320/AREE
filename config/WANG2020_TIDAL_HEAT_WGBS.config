/*
 * AREE :: run configuration for WANG2020_TIDAL_HEAT_WGBS (PRJNA562805)
 *
 * WGBS of adult gill, common-garden F1 of Laoting intertidal (In) and
 * subtidal (Sub) oysters, before (C, 0 h) and after (H, 6 h) 35 C. Same
 * cohort and experiment as LI2018_HEAT_TIDAL (see the study YAML). Four
 * registered comparisons (sample-sheet `condition` = <origin>_<temperature>):
 *
 *   intertidal_vs_subtidal_0h      Sub_C (0) vs In_C (1)   baseline
 *   intertidal_vs_subtidal_6h_heat Sub_H (0) vs In_H (1)   under exposure
 *   heat_35c_6h_vs_0h_subtidal     Sub_C (0) vs Sub_H (1)  exposure, primary
 *   heat_35c_6h_vs_0h_intertidal   In_C  (0) vs In_H  (1)  exposure
 *
 *   nextflow run workflows/methylation \
 *     -config config/WANG2020_TIDAL_HEAT_WGBS.config \
 *     -profile local,workstation
 *
 * methylkit_samplesheet.csv codes intertidal_vs_subtidal_0h only. For the
 * others, regenerate it with the matching --methylkit-levels and set
 * comparison_id to match.
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written. All 12
 * libraries share one BioSample, so the design is parsed from library_name,
 * which carries the paper's group codes (InC_1 ... SubH_3):
 *
 *   aree fetch-samplesheet --bioproject PRJNA562805 \
 *     --study WANG2020_TIDAL_HEAT_WGBS \
 *     --label-field library_name \
 *     --label-pattern '^(?P<origin>In|Sub)(?P<temperature>C|H)_(?P<replicate>[1-3])$' \
 *     --condition-attribute origin --condition-attribute temperature \
 *     --attribute replicate --attribute tissue \
 *     --methylkit-levels Sub_C In_C
 *
 * REPLICATION. Each library pools DNA of five oysters; three pools per group.
 * For the heat contrasts the pools are the replicates (no replicate_unit).
 * For the tidal-origin contrasts tolerance is a population trait and there is
 * one population per class (1 v 1): a 3 v 3 pool test describes these two
 * populations, not tidal origin. There is no replicate_unit that fixes that;
 * report it as such.
 *
 * NOT YET RUN (registered 2026-10-18). 12 paired-end 2 x 150 bp libraries,
 * 66-91 M read pairs each, 140.7 GB of FASTQ. The authors' Bismark default
 * scoring mapped ~30%; start from CIBNOR2021's relaxed --score_min and check
 * M-bias before setting extractor_args (CIBNOR2021's values are a guess here).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    // AREE reanalyzes against its current reference, as for the other
    // raw_reanalysis studies.
    genome_assembly = 'GCF_963853765.1'
    genome_fasta    = 'data/reference/GCF_963853765.1/genomic.fna'
    annotation_gtf  = 'data/reference/GCF_963853765.1/genomic.gtf'

    // FASTQ are not committed (140.7 GB). Verify against
    // data/studies/WANG2020_TIDAL_HEAT_WGBS/fastq_manifest.tsv MD5s.
    reads = 'data/raw/WANG2020_TIDAL_HEAT_WGBS/SRR*_{1,2}.fastq.gz'

    methylation {
        study_id          = 'WANG2020_TIDAL_HEAT_WGBS'
        comparison_id     = 'intertidal_vs_subtidal_0h'
        processed_results = null

        // Sub_C = 0 (reference), In_C = 1, keyed by run accession.
        sample_sheet = 'data/studies/WANG2020_TIDAL_HEAT_WGBS/methylkit_samplesheet.csv'

        // Permissive score_min, as for CIBNOR2021_HEAT_RRSS: the M. gigas
        // genome is highly heterozygous (L,0,-0.6 mapped 53.9% vs 15.5% at
        // default there). Confirm on a 50k-pair subset of one library first.
        bismark_align_args = '--score_min L,0,-0.6'
    }

    outdir = 'results/methylation/WANG2020_TIDAL_HEAT_WGBS'

    // Trimmed reads, the Bismark index and BAMs are large: symlink, never copy.
    publish_mode = 'symlink'
}

process {
    // Sized as for CIBNOR2021_HEAT_RRSS (10-CPU, 26 GB workstation), one
    // alignment at a time.
    withName: 'FASTQC'                        { cpus = 2;  memory = '4 GB';  maxForks = 2 }
    withName: 'TRIM_GALORE'                   { cpus = 4;  memory = '8 GB';  maxForks = 1 }
    withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '16 GB'; time = '12h' }
    withName: 'BISMARK_ALIGN'                 { cpus = 9;  memory = '22 GB'; time = '48h'; maxForks = 1 }
    withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '12 GB'; time = '12h'; maxForks = 2 }
    withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 6;  memory = '12 GB'; time = '24h'; maxForks = 1 }
    withName: 'COVERAGE_FILTER'               { cpus = 1;  memory = '2 GB' }
    withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '24 GB'; time = '12h' }
}

/*
 * AREE :: run configuration for WANG2020_TIDAL_HEAT_WGBS (PRJNA562805)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/WANG2020_TIDAL_HEAT_WGBS.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA562805 --study WANG2020_TIDAL_HEAT_WGBS --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/WANG2020_TIDAL_HEAT_WGBS/samplesheet.tsv'
    reads        = 'data/raw/WANG2020_TIDAL_HEAT_WGBS/*_{1,2}.fastq.gz'
    outdir       = 'results/WANG2020_TIDAL_HEAT_WGBS'
}

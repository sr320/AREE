/*
 * AREE :: run configuration for LIU2019_HEAT_HSF1 (PRJNA516762)
 *
 * Liu et al. 2019, BMC Genomics 20:639 (doi:10.1186/s12864-019-6003-8).
 * 7-month-old oysters, gill; heat shock at 35 C for 2 h vs untreated control,
 * three pooled libraries (five oysters each) per group. The deposit also has
 * HSF1-RNAi and RNAi + heat groups; only the direct heat-vs-control contrast
 * is used, and only its six runs are staged.
 *
 *   nextflow run workflows/rnaseq -config config/LIU2019_HEAT_HSF1.config \
 *     -profile local,workstation
 *
 *   aree fetch-samplesheet --bioproject PRJNA516762 --study LIU2019_HEAT_HSF1 \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<treatment>control|HS&RNAi|HS|RNAi)-(?P<replicate>[1-3])$' \
 *     --condition-attribute treatment --attribute replicate --attribute tissue \
 *     --attribute dev_stage --attribute isolation_source
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LIU2019_HEAT_HSF1'
        // Null so --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'heat_35c_2h_vs_control'

    sample_sheet = 'data/studies/LIU2019_HEAT_HSF1/samplesheet.tsv'

    control_level   = 'control'
    treatment_level = 'HS'

    // The six control and HS runs (19 GB), already staged on this machine
    // from an earlier pass and verified against ENA's MD5s on 2026-10-12.
    reads = 'data/raw/LIU2019_HEAT_HSF1/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/LIU2019_HEAT_HSF1'
}

process {
    // 6 HiSeq X Ten 2x150 libraries, 22.2-31.9 M read pairs. Sized for a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

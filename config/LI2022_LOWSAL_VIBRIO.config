/*
 * AREE :: run configuration for LI2022_LOWSAL_VIBRIO (PRJNA756710)
 *
 * Li et al. 2022, Front Immunol 13:859975 (doi:10.3389/fimmu.2022.859975).
 * Adult gill, every oyster injected with Vibrio alginolyticus, then held at
 * 10 ppt ("10‰Vibrio") or 30 ppt ("30‰Vibrio"); sampled 12 h and 48 h post
 * infection. Three tanks per salinity; each library pools gill from three
 * oysters of one tank, so each library is one tank. Paired-end NovaSeq.
 *
 * Two prespecified comparisons, low vs normal salinity at each timepoint.
 * The default below is the meta_analysis_primary one (48 h):
 *
 *   nextflow run workflows/rnaseq -config config/LI2022_LOWSAL_VIBRIO.config \
 *     -profile local,workstation
 *
 *   --comparison_id lowsal_10ppt_vs_30ppt_vibrio_12h \
 *     --control_level 30ppt_12h --treatment_level 10ppt_12h
 *
 * The two 0 h libraries (C23h2, C23h3: pre-transfer baselines at 30 ppt) are
 * in the sample sheet but in no comparison, and are not downloaded.
 *
 * The BioSample attributes carry neither salinity nor timepoint; both are in
 * each sample's TITLE. design.tsv parses the titles (verbatim title kept in
 * the table) and is joined on the deposited `ID` attribute:
 *
 *   aree fetch-samplesheet --bioproject PRJNA756710 --study LI2022_LOWSAL_VIBRIO \
 *     --design-table data/studies/LI2022_LOWSAL_VIBRIO/design.tsv --design-join ID \
 *     --design-source "<see ena_provenance.json>" \
 *     --condition-attribute salinity --condition-attribute timepoint \
 *     --attribute ID --attribute title_replicate --attribute tissue --attribute geo_loc_name
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LI2022_LOWSAL_VIBRIO'
        // Null so --comparison_id on the command line takes effect (the
        // workflow prefers params.rnaseq.comparison_id over the flat param).
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'lowsal_10ppt_vs_30ppt_vibrio_48h'

    sample_sheet = 'data/studies/LI2022_LOWSAL_VIBRIO/samplesheet.tsv'

    control_level   = '30ppt_48h'
    treatment_level = '10ppt_48h'

    // FASTQ are not committed (34.8 GB for the 12 libraries used). Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/LI2022_LOWSAL_VIBRIO/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    // (the 0 h runs SRR15559847/SRR15559848 are in the manifest but not staged).
    reads = 'data/raw/LI2022_LOWSAL_VIBRIO/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/LI2022_LOWSAL_VIBRIO'
}

process {
    // 12 NovaSeq 6000 2x150 libraries, 20.5-23.3 M read pairs each.
    // Sized to fit a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

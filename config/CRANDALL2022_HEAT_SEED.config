/*
 * AREE :: run configuration for CRANDALL2022_HEAT_SEED (PXD015434)
 *
 * NOT RUN. The study failed QC at registration (2026-10-17): one silo per
 * temperature, the two silos differing in history beyond temperature, and
 * four pools in total. See registry/studies/CRANDALL2022_HEAT_SEED.yaml.
 *
 * The deposited data are DIA peak areas (Skyline/MSstats), not an abundance
 * matrix, so a reanalysis would first need a protein x pool table summarized
 * across each pool's four m/z-range injections.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/CRANDALL2022_HEAT_SEED'

    proteomics {
        study_id      = 'CRANDALL2022_HEAT_SEED'
        comparison_id = 'temp29_vs_temp23_days5and8'
    }
}

/*
 * AREE :: run configuration for LI2022_HEAT_PLOIDY (PRJNA762441)
 *
 * Diploid and triploid gill, each heat condition vs the same ploidy's time-0
 * baseline, n=3 per group. The prespecified pooled comparison is diploid
 * prolonged heat (28 C) vs baseline:
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/LI2022_HEAT_PLOIDY.config \
 *     -profile local,workstation
 *
 * For the other three comparisons, override the id and levels:
 *
 *   --comparison_id diploid_acute_heat_12h_vs_baseline  --control_level d_0 --treatment_level d_12
 *   --comparison_id triploid_prolonged_heat_vs_baseline --control_level t_0 --treatment_level t_f
 *   --comparison_id triploid_acute_heat_12h_vs_baseline --control_level t_0 --treatment_level t_12
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA762441 --study LI2022_HEAT_PLOIDY \
 *     --label-field sample_alias \
 *     --label-pattern '^A(?P<timepoint>0|12|f)(?P<ploidy>d|t)_(?P<replicate>[1-3])$' \
 *     --condition-attribute ploidy --condition-attribute timepoint \
 *     --attribute replicate --attribute 'isolation source' --attribute tissue \
 *     --attribute 'collection date' --attribute 'geo loc name'
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LI2022_HEAT_PLOIDY'
        comparison_id      = 'diploid_prolonged_heat_vs_baseline'
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    // Condition levels are <ploidy>_<time>: d|t x 0|12|f.
    sample_sheet = 'data/studies/LI2022_HEAT_PLOIDY/samplesheet.tsv'

    // Prespecified pooled comparison (meta_analysis_primary in the study YAML).
    control_level   = 'd_0'
    treatment_level = 'd_f'

    // FASTQ are not committed (54.7 GB for all 18 runs). Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/LI2022_HEAT_PLOIDY/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    reads = 'data/raw/LI2022_HEAT_PLOIDY/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/LI2022_HEAT_PLOIDY'
}

process {
    // 18 HiSeq 2000 2x150 libraries, 21.5-27.1 M read pairs each.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

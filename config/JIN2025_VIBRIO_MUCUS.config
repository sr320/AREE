/*
 * AREE :: run configuration for JIN2025_VIBRIO_MUCUS (PXD064651)
 *
 * NOT RUN. Registered only (2026-10-17): no channel-to-sample key and no
 * quantification table were deposited, so the isobaric data cannot be
 * assigned to control or infected samples. See
 * registry/studies/JIN2025_VIBRIO_MUCUS.yaml.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/JIN2025_VIBRIO_MUCUS'

    proteomics {
        study_id      = 'JIN2025_VIBRIO_MUCUS'
        comparison_id = 'vibrio_zj51_vs_control'
    }
}

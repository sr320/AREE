/*
 * AREE :: run configuration for ZWU2022_VIBRIO_TIMECOURSE (PRJNA852380)
 *
 * Deposited by Zhejiang Wanli University, no publication found. 9-month-old
 * intertidal oysters (Qingdao), digestive gland; untreated controls and
 * oysters 1, 3, 6, 12 and 24 h after Vibrio exposure, three libraries per
 * group. Vibrio species, dose and route are not in the deposit.
 *
 * Five prespecified comparisons, each time point vs the untreated controls.
 * Default = the meta_analysis_primary one (24 h):
 *
 *   nextflow run workflows/rnaseq -config config/ZWU2022_VIBRIO_TIMECOURSE.config \
 *     -profile local,workstation
 *
 *   --comparison_id vibrio_12h_vs_control --treatment_level V12h
 *   --comparison_id vibrio_6h_vs_control  --treatment_level V6h
 *   --comparison_id vibrio_3h_vs_control  --treatment_level V3h
 *   --comparison_id vibrio_1h_vs_control  --treatment_level V1h
 *
 *   aree fetch-samplesheet --bioproject PRJNA852380 --study ZWU2022_VIBRIO_TIMECOURSE \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<group>control|V1h|V3h|V6h|V12h|V24h)_?(?P<replicate>[1-3])$' \
 *     --condition-attribute group --attribute replicate --attribute isolate --attribute tissue \
 *     --attribute age --attribute isolation_source --attribute collection_date
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'ZWU2022_VIBRIO_TIMECOURSE'
        // Null so --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'vibrio_24h_vs_control'

    sample_sheet = 'data/studies/ZWU2022_VIBRIO_TIMECOURSE/samplesheet.tsv'

    control_level   = 'control'
    treatment_level = 'V24h'

    // FASTQ are not committed (59 GB for all 18 runs). Verify against ENA's MD5s
    // from data/studies/ZWU2022_VIBRIO_TIMECOURSE/fastq_manifest.tsv.
    reads = 'data/raw/ZWU2022_VIBRIO_TIMECOURSE/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/ZWU2022_VIBRIO_TIMECOURSE'
}

process {
    // 18 HiSeq X Ten 2x150 libraries, 20.6-27.6 M read pairs. Sized for a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

/*
 * AREE :: run configuration for ZWU2022_VIBRIO_TIMECOURSE (PRJNA852380)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/ZWU2022_VIBRIO_TIMECOURSE.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA852380 --study ZWU2022_VIBRIO_TIMECOURSE --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/ZWU2022_VIBRIO_TIMECOURSE/samplesheet.tsv'
    reads        = 'data/raw/ZWU2022_VIBRIO_TIMECOURSE/*_{1,2}.fastq.gz'
    outdir       = 'results/ZWU2022_VIBRIO_TIMECOURSE'
}

/*
 * AREE :: run configuration for IOCAS2024_OA_TRANSGEN (PRJNA1196326)
 *
 * Transgenerational ocean acidification: larvae from parents held at pH 7.4
 * (S74) vs pH 8.1 (S81), nominally n=3 libraries per group. One comparison:
 *
 *   nextflow run workflows/rnaseq -config config/IOCAS2024_OA_TRANSGEN.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written. The
 * deposit puts the parental pH only in the sample alias (S74_1 ... S81_3);
 * BioSample `isolate` says 'acidification group 1' / 'wild type group1'.
 *
 *   aree fetch-samplesheet --bioproject PRJNA1196326 --study IOCAS2024_OA_TRANSGEN \
 *     --label-field sample_alias \
 *     --label-pattern '^S(?P<parental_ph>74|81)_(?P<replicate>[1-3])$' \
 *     --condition-attribute parental_ph --attribute replicate --attribute isolate \
 *     --attribute tissue --attribute collection_date --attribute isolation_source
 *
 * Run scripts/check_replicate_dispersion.py on the Salmon output before
 * harmonizing anything (see the QC note in the study YAML).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'IOCAS2024_OA_TRANSGEN'
        comparison_id      = 'parental_ph7_4_vs_ph8_1_larvae'
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/IOCAS2024_OA_TRANSGEN/samplesheet.tsv'

    // condition = parental pH x 10, read from the sample alias.
    control_level   = '81'
    treatment_level = '74'

    // FASTQ are not committed (16.4 GB for all 6 runs). Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/IOCAS2024_OA_TRANSGEN/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    reads = 'data/raw/IOCAS2024_OA_TRANSGEN/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/IOCAS2024_OA_TRANSGEN'
}

process {
    // 6 NovaSeq 6000 2x150 libraries, 17.1-21.8 M read pairs each.
    // Sized to run on a 16 GB machine: a transcriptome-only (no decoy) index
    // of rna.fna needs well under 12 GB.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

/*
 * AREE :: run configuration for DUPERRET2025_POMS_STARVE (MetaboLights MTBLS13313)
 *
 * NOT RUNNABLE YET. The metabolomics workflow's raw_reanalysis mode takes an
 * aligned feature-by-sample intensity table, not vendor raw files. This study
 * deposits only Agilent MassHunter .d files (targeted dynamic MRM, four
 * platforms), and its MetaboLights MAFs contain no abundance values (see
 * data/studies/DUPERRET2025_POMS_STARVE/metabolights_provenance.json).
 *
 * To run it, first produce one integrated peak-area table per platform, from
 * the paper's supplementary data if it has them, or by integrating the MRM
 * transitions from the raw files (e.g. msconvert to mzML, then Skyline), and
 * record that step's version and parameters. Then set raw_feature_table and:
 *
 *   nextflow run workflows/metabolomics -config config/DUPERRET2025_POMS_STARVE.config -profile local
 *
 * Subset the sample sheet to timepoint_hpc == 0 for the registered comparison,
 * with fed as control. The replicate unit is the tank, and family is a
 * within-tank factor. Diet is confounded with MS batch; see the study YAML.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/DUPERRET2025_POMS_STARVE'

    metabolomics {
        raw_feature_table = null   // not yet available: see header
        sample_sheet      = 'data/studies/DUPERRET2025_POMS_STARVE/samplesheet.tsv'
        study_id          = 'DUPERRET2025_POMS_STARVE'
        comparison_id     = 'starved_vs_fed_0hpc'
    }
}

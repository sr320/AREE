/*
 * AREE :: run configuration for UW2020_OA_PLOIDY_WGBS (PRJNA682817)
 *
 * WGBS of adult ctenidia, diploid (2N) and triploid (3N) oysters at water
 * pH 8.2 (HI) vs 7.7 (LOW), one oyster per library, n = 6 per cell.
 * Two registered comparisons (sample-sheet `condition` = <ploidy>_<ph>):
 *
 *   diploid_ph7_7_vs_ph8_2    2N_HI (0) vs 2N_LOW (1)   primary
 *   triploid_ph7_7_vs_ph8_2   3N_HI (0) vs 3N_LOW (1)
 *
 *   nextflow run workflows/methylation \
 *     -config config/UW2020_OA_PLOIDY_WGBS.config \
 *     -profile local,workstation
 *
 * methylkit_samplesheet.csv codes diploid_ph7_7_vs_ph8_2. For the triploid
 * comparison, regenerate it with --methylkit-levels 3N_HI 3N_LOW and set
 * comparison_id to match (alignment is cached by -resume).
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA682817 \
 *     --study UW2020_OA_PLOIDY_WGBS \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<ploidy>2N|3N)_(?P<ph>LOW|HI)_(?P<replicate>[0-9]{2})$' \
 *     --condition-attribute ploidy --condition-attribute ph \
 *     --attribute replicate --attribute tissue \
 *     --methylkit-levels 2N_HI 2N_LOW
 *
 * REPLICATION. One oyster per library, so no replicate_unit. The tank layout
 * is not recorded (see the study YAML); if each pH was one tank, the test
 * is of tanks, not of pH.
 *
 * 24 NovaSeq 6000 PE libraries, 37-83 M read pairs (1,240 M total), 145.2 GB
 * of FASTQ. At Chlo's ~11 M pairs/h Bismark throughput, alignment alone is
 * about 4-5 days.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    genome_assembly = 'GCF_963853765.1'
    genome_fasta    = 'data/reference/GCF_963853765.1/genomic.fna'
    annotation_gtf  = 'data/reference/GCF_963853765.1/genomic.gtf'

    // FASTQ are not committed (145.2 GB). Verify against
    // data/studies/UW2020_OA_PLOIDY_WGBS/fastq_manifest.tsv MD5s.
    reads = 'data/raw/UW2020_OA_PLOIDY_WGBS/SRR*_{1,2}.fastq.gz'

    methylation {
        study_id          = 'UW2020_OA_PLOIDY_WGBS'
        comparison_id     = 'diploid_ph7_7_vs_ph8_2'
        processed_results = null

        // 2N_HI = 0 (reference), 2N_LOW = 1, keyed by run accession.
        sample_sheet = 'data/studies/UW2020_OA_PLOIDY_WGBS/methylkit_samplesheet.csv'

        // Permissive score_min, as for CIBNOR2021_HEAT_RRSS (the M. gigas
        // genome is highly heterozygous). Check on a subset first.
        bismark_align_args = '--score_min L,0,-0.6'

        // Individual oysters, n = 6 v 6: limma on per-oyster gene units, as
        // for CIBNOR2021 (calibrated where methylKit MN and DSS were not).
        dmr_engine        = 'limma'
        dmr_features      = 'genes'
        min_coverage      = 1
        unit_min_coverage = 10
        tile_min_cpgs     = 10
    }

    outdir = 'results/methylation/UW2020_OA_PLOIDY_WGBS'

    // Trimmed reads, the Bismark index and BAMs are large: symlink, never copy.
    publish_mode = 'symlink'
}

process {
    // Sized for Chlo (10 CPUs, 26 GB), one alignment at a time.
    withName: 'FASTQC'                        { cpus = 2;  memory = '4 GB';  maxForks = 2 }
    withName: 'TRIM_GALORE'                   { cpus = 4;  memory = '8 GB';  maxForks = 1 }
    withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '16 GB'; time = '12h' }
    withName: 'BISMARK_ALIGN'                 { cpus = 9;  memory = '22 GB'; time = '48h'; maxForks = 1 }
    withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '12 GB'; time = '12h'; maxForks = 2 }
    withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 6;  memory = '12 GB'; time = '24h'; maxForks = 1 }
    withName: 'COVERAGE_FILTER'               { cpus = 1;  memory = '2 GB' }
    withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '24 GB'; time = '12h' }
    withName: 'DMR_POOLED_TILES'              { cpus = 2;  memory = '22 GB'; time = '6h' }
}

/*
 * AREE :: run configuration for CALLA2026_OSHV (PRJNA1329250)
 *
 * The first real raw_reanalysis study registered in AREE. This config is
 * complete and parameterized; it has NOT been executed. Running it requires
 * ~226 GB of FASTQ, a Salmon index for GCF_963853765.1, and a machine with
 * Docker/Apptainer and Nextflow. See docs/first_raw_reanalysis.md.
 *
 * Usage (per comparison):
 *   nextflow run workflows/rnaseq \
 *     -config config/CALLA2026_OSHV.config \
 *     -profile docker \
 *     --comparison_id midori_oshv1_france_vs_control
 *
 * The sample sheet and FASTQ manifest referenced below are generated, not
 * hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA1329250 --study CALLA2026_OSHV \
 *     --condition-attribute breed --condition-attribute "Viral strain" \
 *     --attribute dev_stage --attribute tissue
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'CALLA2026_OSHV'
        // Overridden on the command line per comparison; the study registers six.
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    // Design, generated from the deposited BioSample attributes. The `condition`
    // column holds <breed>_<viral strain>, e.g. Midori_France, Midori_Control.
    sample_sheet = 'data/studies/CALLA2026_OSHV/samplesheet.tsv'

    // FASTQ are NOT committed (226 GB). Stage them first — fastq_manifest.tsv
    // carries ENA's own MD5 for every file, so verify after download rather
    // than assuming a clean transfer:
    //   awk -F'\t' 'NR>1 {print $4"  "$1"_"$2".fastq.gz"}' \
    //     data/studies/CALLA2026_OSHV/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    reads = 'data/raw/CALLA2026_OSHV/*_{1,2}.fastq.gz'

    // Reference. AREE reanalyzes against the current NCBI reference annotation,
    // which is the same annotation the identifier crosswalk is built from — so
    // feature_id_standardized needs no cross-assembly remapping for this study.
    // Fetch with:
    //   datasets download genome accession GCF_963853765.1 --include rna,gtf
    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null   // built from transcript_fasta if not supplied

    outdir = 'results/rnaseq/CALLA2026_OSHV'
}

process {
    // 42 paired-end NovaSeq libraries at ~37M read pairs each. These are
    // starting points sized for a single workstation, not tuned values.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

/*
 * AREE :: run configuration for WANG2024_HEAT_GILL (PRJNA970954)
 *
 * C. gigas adult gill, 12 h heat vs no heat, n=3 per arm. The deposit also
 * holds C. angulata and ATAC-seq runs. Point --reads at the 6 C. gigas
 * RNA-seq libraries only (SRR24489461, -63, -65, -71, -81, -83):
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/WANG2024_HEAT_GILL.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA970954 --study WANG2024_HEAT_GILL \
 *     --label-field library_name \
 *     --label-pattern '^(?P<heat>HC|NC)\.(?P<species>gigas|angulata)(?P<replicate>[1-3])_(?P<assay>RNA-Seq|ATAC-Seq)_fastq$' \
 *     --condition-attribute assay --condition-attribute species --condition-attribute heat \
 *     --attribute replicate --attribute tissue --attribute organism \
 *     --attribute collection_date --attribute geo_loc_name --attribute "replicate'_attribute"
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'WANG2024_HEAT_GILL'
        // Keep null: the workflow reads rnaseq.comparison_id before
        // --comparison_id (see LI2022_HEAT_PLOIDY).
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'gigas_heat_12h_vs_control'

    // Condition levels are <assay>_<species>_<HC|NC>.
    sample_sheet = 'data/studies/WANG2024_HEAT_GILL/samplesheet.tsv'

    // Prespecified comparison (meta_analysis_primary in the study YAML).
    control_level   = 'RNA_Seq_gigas_NC'
    treatment_level = 'RNA_Seq_gigas_HC'

    // FASTQ are not committed. Stage only the C. gigas RNA-seq runs and verify
    // them against data/studies/WANG2024_HEAT_GILL/fastq_manifest.tsv.
    reads = 'data/raw/WANG2024_HEAT_GILL/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/WANG2024_HEAT_GILL'
}

process {
    // 6 NovaSeq 2x150 libraries, 21.1-24.7 M read pairs each.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

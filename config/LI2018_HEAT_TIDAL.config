/*
 * AREE :: run configuration for LI2018_HEAT_TIDAL (PRJNA407831)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/LI2018_HEAT_TIDAL.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA407831 --study LI2018_HEAT_TIDAL --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/LI2018_HEAT_TIDAL/samplesheet.tsv'
    reads        = 'data/raw/LI2018_HEAT_TIDAL/*_{1,2}.fastq.gz'
    outdir       = 'results/LI2018_HEAT_TIDAL'
}

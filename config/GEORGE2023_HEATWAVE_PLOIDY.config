/*
 * AREE :: run configuration for GEORGE2023_HEATWAVE_PLOIDY (PRJNA913164)
 *
 * George et al. 2023, Glob Chang Biol 29:6969 (doi:10.1111/gcb.16880).
 * Adult diploid and triploid ctenidium, 72 single-end QuantSeq 3' Tag-seq
 * libraries: control (20 C, submerged), single stressor (30 C seawater) and
 * multiple stressor (30 C, then 6 h aerial emersion at 44 C), 12 per
 * ploidy x treatment cell. Needs --single_end and --tag_seq.
 *
 * Four prespecified comparisons, each stressor against the ploidy-matched
 * control. The default below is the meta_analysis_primary one:
 *
 *   nextflow run workflows/rnaseq -config config/GEORGE2023_HEATWAVE_PLOIDY.config \
 *     -profile local,workstation
 *
 * The other three override the levels and id:
 *
 *   --comparison_id triploid_30c_vs_control_20c \
 *     --control_level triploid_control --treatment_level triploid_single_stressor
 *   --comparison_id diploid_30c_44c_emersion_vs_control_20c \
 *     --control_level diploid_control --treatment_level diploid_multiple_stressor
 *   --comparison_id triploid_30c_44c_emersion_vs_control_20c \
 *     --control_level triploid_control --treatment_level triploid_multiple_stressor
 *
 * The BioSamples carry no treatment or ploidy, so the design is joined from
 * the authors' NCBI submission sheet (design.tsv, derived from
 * authors_ncbi_attributes.tsv in the study directory):
 *
 *   aree fetch-samplesheet --bioproject PRJNA913164 --study GEORGE2023_HEATWAVE_PLOIDY \
 *     --design-table data/studies/GEORGE2023_HEATWAVE_PLOIDY/design.tsv --design-join isolate \
 *     --design-source "<URL in ena_provenance.json>" \
 *     --condition-attribute ploidy --condition-attribute treatment \
 *     --attribute isolate --attribute authors_description --attribute tissue \
 *     --attribute age --attribute collection_date
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'GEORGE2023_HEATWAVE_PLOIDY'
        comparison_id      = 'diploid_30c_vs_control_20c'
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/GEORGE2023_HEATWAVE_PLOIDY/samplesheet.tsv'

    control_level   = 'diploid_control'
    treatment_level = 'diploid_single_stressor'

    // The eight libraries the authors dropped as outliers before DESeq2
    // (2_DESeq2_analysis-gigas-filtered.Rmd, lines 111-116, at commit 24e7abd
    // of github.com/mattgeorgephd/NOPP-gigas-ploidy-temp). Prespecified for
    // every comparison; ids outside a comparison's arms have no effect.
    exclude_samples = 'D54,N56,X44,R53,M43,N54,X42,T62'

    single_end = true
    tag_seq    = true

    // FASTQ are not committed (17.9 GB for all 72 runs). Verify against ENA's MD5s:
    //   awk -F'\t' 'NR>1 {print $4"  "$1".fastq.gz"}' \
    //     data/studies/GEORGE2023_HEATWAVE_PLOIDY/fastq_manifest.tsv > md5sums.txt && md5sum -c md5sums.txt
    reads = 'data/raw/GEORGE2023_HEATWAVE_PLOIDY/SRR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/GEORGE2023_HEATWAVE_PLOIDY'
}

process {
    // 72 NovaSeq 6000 single-end 101 bp QuantSeq libraries, 0.9-8.3 M reads.
    // Sized to fit a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 4;  memory = '8 GB';  time = '1h'  }
    withName: 'TRIM_FASTP'   { cpus = 2;  memory = '4 GB';  time = '1h'  }
    withName: 'FASTQC'       { cpus = 1;  memory = '2 GB';  time = '1h'  }
}

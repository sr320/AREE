/*
 * AREE :: run configuration for GEORGE2023_HEATWAVE_PLOIDY (PRJNA913164)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/GEORGE2023_HEATWAVE_PLOIDY.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA913164 --study GEORGE2023_HEATWAVE_PLOIDY --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/GEORGE2023_HEATWAVE_PLOIDY/samplesheet.tsv'
    reads        = 'data/raw/GEORGE2023_HEATWAVE_PLOIDY/*_{1,2}.fastq.gz'
    outdir       = 'results/GEORGE2023_HEATWAVE_PLOIDY'
}

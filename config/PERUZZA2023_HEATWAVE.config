/*
 * AREE :: run configuration for PERUZZA2023_HEATWAVE (PRJNA906528)
 *
 * The libraries are Lexogen QuantSeq 3' mRNA-Seq FWD (75 bp single-end; the
 * paper's methods, section 2.10), so the run uses --tag_seq: fastp trims
 * poly(A) tails, Salmon runs with --noLengthCorrection, and DESeq2 fits counts
 * without length offsets. Never run this study without it. ENA labels the
 * libraries library_selection PolyA, which hides this; the reads show it too
 * (poly-A runs on the read, almost no poly-T).
 *
 * Sex is fitted as a covariate (~ sex + condition): the arms are unbalanced
 * (20 C: 15 male, 5 female; 30 C: 10 and 10) and the authors found the
 * heatwave response differs by sex. The deposited sex was predicted from
 * digestive-gland transcriptomes by the authors' classifier, not observed;
 * see limitations in registry/studies/PERUZZA2023_HEATWAVE.yaml.
 *
 * Tank is the unit of treatment (4 tanks per arm, 5 clams sampled per tank),
 * but tank membership is not deposited, so replicate_unit cannot be set. The
 * study carries tank_level_replication, as TUCCI2025_HEAT_PRIMING does.
 *
 *   nextflow run workflows/rnaseq -config config/PERUZZA2023_HEATWAVE.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA906528 --study PERUZZA2023_HEATWAVE \
 *     --condition-attribute temp --attribute sex --library-strategy RNA-Seq
 *
 * The reference bundle comes from `aree fetch-reference --assembly ASM2657151v2`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode       = 'raw_reanalysis'
    single_end = true
    tag_seq    = true   // QuantSeq 3' Tag-Seq: no length correction anywhere

    rnaseq {
        study_id           = 'PERUZZA2023_HEATWAVE'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_026571515.1'
        annotation_version = 'GCF_026571515.1-RS_2023_10'
        processed_results  = null
    }

    // Prespecified primary comparison (meta_analysis_primary in the study YAML).
    comparison_id = 'heatwave_30c_vs_control_20c'

    sample_sheet = 'data/studies/PERUZZA2023_HEATWAVE/samplesheet.tsv'

    // Condition levels are the BioSample attribute `temp`.
    control_level   = '20'
    treatment_level = '30'

    covariates = 'sex'

    // FASTQ are not committed (7.9 GB for the 40 RNA-seq runs). Verify
    // against ENA's MD5s in data/studies/PERUZZA2023_HEATWAVE/fastq_manifest.tsv.
    // Single-end: one file per run.
    reads = 'data/raw/PERUZZA2023_HEATWAVE/SRR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_026571515.1/rna.fna'
    gtf              = 'data/reference/GCF_026571515.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_026571515.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/PERUZZA2023_HEATWAVE'
}

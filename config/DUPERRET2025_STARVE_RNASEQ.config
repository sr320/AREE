/*
 * AREE :: run configuration for DUPERRET2025_STARVE_RNASEQ (PRJEB86618 + PRJEB86525)
 *
 * Single-end 75 bp libraries: run with `single_end = true` (below), which
 * needs the single-end workflow support merged in PR #25. fastp trims the
 * Illumina TruSeq / NEBNext read-1 adapter (the workflow's default
 * se_adapter), not an auto-detected one.
 *
 * FIT ON TANKS. Both families share each tank, so their two libraries are
 * summed per tank before DESeq2 (--replicate_unit), giving 3 vs 3 tank units.
 * Do not use --covariates family for these contrasts: it would treat the two
 * libraries from one tank as independent replicates (see the study YAML).
 *
 * Registered comparisons (sample-sheet `condition` = <diet_code>_<hpc>;
 * diet code 3 = fed, 5 = starved):
 *
 *   starved_vs_fed_0hpc           --control_level 3_0  --treatment_level 5_0   --replicate_unit tank
 *   fed_oshv1_24hpc_vs_0hpc       --control_level 3_0  --treatment_level 3_24  --replicate_unit tank_hpc
 *   starved_oshv1_24hpc_vs_0hpc   --control_level 5_0  --treatment_level 5_24  --replicate_unit tank_hpc
 *
 * The time contrasts use tank_hpc because the same tank is sampled at 0 and
 * 24 hpc, so a `tank` unit would fall in both arms.
 *
 * Per-family sensitivity runs: subset the sample sheet to one family and
 * drop --replicate_unit (one library per tank per time, 3 vs 3).
 *
 *   nextflow run workflows/rnaseq -config config/DUPERRET2025_STARVE_RNASEQ.config \
 *     -profile local,workstation --comparison_id starved_vs_fed_0hpc
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 * `aree fetch-samplesheet` was run once per BioProject and the outputs were
 * concatenated. The exact command is in the study YAML curation_notes, and
 * both provenance records are in ena_provenance.json.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'DUPERRET2025_STARVE_RNASEQ'
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/DUPERRET2025_STARVE_RNASEQ/samplesheet.tsv'

    // Primary comparison, fitted on tanks.
    control_level   = '3_0'
    treatment_level = '5_0'
    replicate_unit  = 'tank'

    // FASTQ are not committed. Stage and checksum against
    // data/studies/DUPERRET2025_STARVE_RNASEQ/fastq_manifest.tsv (83 single-end
    // files, about 104 GB). One file per run; sample ids are run accessions.
    reads      = 'data/raw/DUPERRET2025_STARVE_RNASEQ/ERR*.fastq.gz'
    single_end = true

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/DUPERRET2025_STARVE_RNASEQ'
}

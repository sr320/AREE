/*
 * AREE :: run configuration for DUPERRET2025_STARVE_RNASEQ (PRJEB86618 + PRJEB86525)
 *
 * NOT RUNNABLE YET, for two reasons that need workflow changes in their own PR:
 *   1. The libraries are single-end 75 bp. workflows/rnaseq reads input with
 *      fromFilePairs, and TRIM_FASTP / SALMON_QUANT / VIRAL_QUANT pass
 *      -i/-I and -1/-2, so paired-end only.
 *   2. Family should be a covariate (~ family + condition). DESeq2 currently
 *      fits ~condition. Until it accepts a covariate column, subset the
 *      sample sheet to one family per run, as the paper did.
 *
 * Registered comparisons (sample-sheet `condition` = <diet_code>_<hpc>;
 * diet code 3 = fed, 5 = starved):
 *
 *   starved_vs_fed_0hpc           --control_level 3_0  --treatment_level 5_0
 *   fed_oshv1_24hpc_vs_0hpc       --control_level 3_0  --treatment_level 3_24
 *   starved_oshv1_24hpc_vs_0hpc   --control_level 5_0  --treatment_level 5_24
 *
 *   nextflow run workflows/rnaseq -config config/DUPERRET2025_STARVE_RNASEQ.config \
 *     -profile local,workstation --comparison_id starved_vs_fed_0hpc
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 * `aree fetch-samplesheet` was run once per BioProject and the outputs were
 * concatenated. The exact command is in the study YAML curation_notes, and
 * both provenance records are in ena_provenance.json.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'DUPERRET2025_STARVE_RNASEQ'
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/DUPERRET2025_STARVE_RNASEQ/samplesheet.tsv'

    // Primary comparison.
    control_level   = '3_0'
    treatment_level = '5_0'

    // FASTQ are not committed. Stage and checksum against
    // data/studies/DUPERRET2025_STARVE_RNASEQ/fastq_manifest.tsv (83 single-end
    // files, about 104 GB). This glob assumes single-end input support.
    reads = 'data/raw/DUPERRET2025_STARVE_RNASEQ/ERR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/DUPERRET2025_STARVE_RNASEQ'
}

// AREE demo configuration
//
// STATUS: scaffold. Points workflow `params.*` inputs at the repository's
// synthetic demo files under data/demo/ so `-profile demo` (or
// `-config ../../config/demo.config`) gives a runnable, self-contained
// example of wiring for each assay's `processed_results_harmonization` mode.
//
// IMPORTANT: data/demo/**/*.tsv files are already-processed, clearly labeled
// SIMULATED result tables (DE tables, DMR tables, protein/metabolite feature
// tables). They are NOT raw FASTQ/BAM/mzML and cannot be used to demonstrate
// the raw_reanalysis mode of these workflows end-to-end — there is no raw
// synthetic sequencing data in this repository. This config therefore only
// demonstrates `--mode processed_results_harmonization` for each workflow.
// A `raw_reanalysis` smoke test would need small synthetic FASTQ/BAM/mzML
// fixtures, which is listed as future work (see workflows/*/README.md).

params {
    mode   = 'processed_results_harmonization'
    outdir = 'results/demo'

    // RNA-seq: one demo DESeq2-style DE table (see workflows/rnaseq/README.md)
    rnaseq {
        processed_results = "${projectDir}/../../data/demo/rnaseq/GIGAS_HEAT01_acute_heat_vs_control_dge_demo.tsv"
        study_id           = 'GIGAS_HEAT01'
        comparison_id       = 'acute_heat_vs_control'
    }

    // Methylation: one demo DMR table
    methylation {
        processed_results = "${projectDir}/../../data/demo/methylation/GIGAS_PATH03_OsHV1_challenge_vs_sham_dmr_demo.tsv"
        study_id           = 'GIGAS_PATH03'
        comparison_id       = 'OsHV1_challenge_vs_sham'
    }

    // Proteomics: one demo protein abundance table
    proteomics {
        processed_results = "${projectDir}/../../data/demo/proteomics/GIGAS_SAL04_low_salinity_vs_control_protein_abundance_demo.tsv"
        study_id           = 'GIGAS_SAL04'
        comparison_id       = 'low_salinity_vs_control'
    }

    // Metabolomics: one demo metabolite feature table
    metabolomics {
        processed_results = "${projectDir}/../../data/demo/metabolomics/GIGAS_GROW06_hypoxia_vs_control_metabolite_features_demo.tsv"
        study_id           = 'GIGAS_GROW06'
        comparison_id       = 'hypoxia_vs_control'
    }
}

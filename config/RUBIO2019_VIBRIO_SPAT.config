/*
 * AREE :: run configuration for RUBIO2019_VIBRIO_SPAT (PRJNA515169)
 *
 * Rubio et al. 2019, PNAS 116:14238 (doi:10.1073/pnas.1905747116).
 * Juvenile spat (Decipher 14 family) injected into the adductor muscle with
 * virulent (V. crassostreae J2-9, V. tasmaniensis LGP32) or non-virulent
 * (J2-8, LMG20012T) vibrios at 20 C, or mock-injected with sterile seawater
 * (sample alias 'anesthesis'), and sampled 8 h later, before any death. One
 * pool of 30 spat per condition in each of three independent experimental
 * infections (the alias 'replicateN' = experiment N).
 *
 * Four prespecified comparisons, each blocked on experiment
 * (~ experiment + condition). Default = the meta_analysis_primary one:
 *
 *   nextflow run workflows/rnaseq -config config/RUBIO2019_VIBRIO_SPAT.config \
 *     -profile local,workstation
 *
 *   --comparison_id vtasma_lgp32_virulent_vs_mock_8h      --treatment_level Vtasma_LGP32
 *   --comparison_id vcrass_virulent_vs_nonvirulent_8h     --control_level Vcrass_J2_8      --treatment_level Vcrass_J2_9
 *   --comparison_id vtasma_virulent_vs_nonvirulent_8h     --control_level Vtasma_LMG20012T --treatment_level Vtasma_LGP32
 *
 *   aree fetch-samplesheet --bioproject PRJNA515169 --study RUBIO2019_VIBRIO_SPAT \
 *     --label-field sample_alias \
 *     --label-pattern '^RNAseq_(?P<treatment>untreated|anesthesis|Vcrass_J2-8|Vcrass_J2-9|Vtasma_LGP32|Vtasma_LMG20012T)_replicate(?P<experiment>[1-3])$' \
 *     --condition-attribute treatment --attribute experiment --attribute tissue --attribute dev_stage
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'RUBIO2019_VIBRIO_SPAT'
        // Null so --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'vcrass_j29_virulent_vs_mock_8h'

    sample_sheet = 'data/studies/RUBIO2019_VIBRIO_SPAT/samplesheet.tsv'

    control_level   = 'anesthesis'
    treatment_level = 'Vcrass_J2_9'

    // Each experiment contributed one pool per condition: block on it.
    covariates = 'experiment'

    // The 15 runs used (untreated time-0 pools not staged, ~32 GB). Verify
    // against ENA's MD5s from data/studies/RUBIO2019_VIBRIO_SPAT/fastq_manifest.tsv.
    reads = 'data/raw/RUBIO2019_VIBRIO_SPAT/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/RUBIO2019_VIBRIO_SPAT'
}

process {
    // 18 HiSeq 2500 paired-end libraries deposited, 15 used. Sized for a 16 GB machine.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '12 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '12 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

/*
 * AREE :: run configuration for IOCAS2022_OA_ENERGY (PRJNA826964)
 *
 * First real ocean-acidification study: OA vs time-matched control in adult
 * digestive gland at 7, 28 and 56 d, n=3 per group. The prespecified pooled
 * comparison is 28 d:
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/IOCAS2022_OA_ENERGY.config \
 *     -profile local,workstation \
 *     --comparison_id oa_28d_vs_control_28d
 *
 * For the other two comparisons, override the levels:
 *
 *   --comparison_id oa_7d_vs_control_7d   --control_level control_7d  --treatment_level ocean_acidification_7d
 *   --comparison_id oa_56d_vs_control_56d --control_level control_56d --treatment_level ocean_acidification_56d
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA826964 \
 *     --study IOCAS2022_OA_ENERGY \
 *     --condition-attribute treatment \
 *     --attribute replicate \
 *     --attribute tissue
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'IOCAS2022_OA_ENERGY'
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/IOCAS2022_OA_ENERGY/samplesheet.tsv'

    // Prespecified pooled comparison (meta_analysis_primary in the study YAML).
    control_level   = 'control_28d'
    treatment_level = 'ocean_acidification_28d'

    // FASTQ are not committed. Stage and checksum using
    // data/studies/IOCAS2022_OA_ENERGY/fastq_manifest.tsv.
    reads = 'data/raw/IOCAS2022_OA_ENERGY/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/IOCAS2022_OA_ENERGY'
}

process {
    // 18 HiSeq 2500 libraries, ~57 GB FASTQ in ENA.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

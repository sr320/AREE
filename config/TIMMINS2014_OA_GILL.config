/*
 * AREE :: run configuration for TIMMINS2014_OA_GILL (PXD000835)
 *
 * Proteomics raw_reanalysis on the paper's per-oyster NSAF table (Table S3),
 * one run per comparison, e.g.
 *
 *   python -I data/studies/TIMMINS2014_OA_GILL/build_inputs.py --download STAGING
 *   nextflow run workflows/proteomics -c config/TIMMINS2014_OA_GILL.config -profile local \
 *       --proteomics.comparison_id pco2_2800_vs_400 \
 *       --proteomics.sample_sheet data/studies/TIMMINS2014_OA_GILL/samplesheet_pco2_2800_vs_400.tsv
 *
 * Needs workflows/proteomics with the raw-mode options of PR #80.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/TIMMINS2014_OA_GILL'

    proteomics {
        study_id             = 'TIMMINS2014_OA_GILL'
        raw_abundance_matrix = 'data/studies/TIMMINS2014_OA_GILL/nsaf_matrix.tsv'
        id_mapping_table     = 'data/reference/crosswalk/mgigas_gene_id_crosswalk.tsv'
        input_scale          = 'linear'          // NSAF: linear, zeros = not detected
        normalization        = 'none'            // NSAF is normalized within each oyster
        quantification       = 'spectral_count'
        min_detected_per_arm = 3                 // of 4 oysters per arm
    }
}

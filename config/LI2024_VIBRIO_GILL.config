/*
 * AREE :: run configuration for LI2024_VIBRIO_GILL (PRJNA830931)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/LI2024_VIBRIO_GILL.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA830931 --study LI2024_VIBRIO_GILL --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/LI2024_VIBRIO_GILL/samplesheet.tsv'
    reads        = 'data/raw/LI2024_VIBRIO_GILL/*_{1,2}.fastq.gz'
    outdir       = 'results/LI2024_VIBRIO_GILL'
}

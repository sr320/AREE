/*
 * AREE :: run configuration for LI2024_VIBRIO_GILL (PRJNA830931)
 *
 * Gill at 0, 6 and 48 h after Vibrio alginolyticus infection, n=3 per time
 * point. The prespecified pooled comparison is 48 h vs 0 h:
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/LI2024_VIBRIO_GILL.config \
 *     -profile local,workstation
 *
 * The other comparison:
 *   --comparison_id valginolyticus_6h_vs_0h --control_level 0h --treatment_level 6h
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA830931 --study LI2024_VIBRIO_GILL \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<timepoint>0h|6h|48h)_replicate(?P<replicate>[1-3])$' \
 *     --condition-attribute timepoint --attribute replicate --attribute tissue \
 *     --attribute collection_date --attribute geo_loc_name
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'LI2024_VIBRIO_GILL'
        // Keep null: the workflow reads rnaseq.comparison_id before
        // --comparison_id (see LI2022_HEAT_PLOIDY).
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'valginolyticus_48h_vs_0h'

    sample_sheet = 'data/studies/LI2024_VIBRIO_GILL/samplesheet.tsv'

    control_level   = '0h'
    treatment_level = '48h'

    reads = 'data/raw/LI2024_VIBRIO_GILL/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/LI2024_VIBRIO_GILL'
}

process {
    // 9 NovaSeq 2x150 libraries, 20.1-27.8 M read pairs each.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

/*
 * AREE :: run configuration for ZJOU2023_HEAT (PRJNA954971)
 *
 * Mediterranean mussel (Mytilus galloprovincialis), Zhoushan, gill and
 * mantle, 30 vs 18 C, n = 3 per tissue x temperature. Paired-end
 * BGISEQ-500 full-length libraries, so the standard RNA-seq path applies:
 * no tag_seq, Salmon length correction and DESeq2 length offsets on.
 *
 * The sample sheet's `condition` is <tissue>_<temperature> from the sample
 * aliases: G = gill, M = mantle; C = 18 C control, H = 30 C heat.
 * Tissues are fitted separately.
 *
 * Primary comparison (meta_analysis_primary in the study YAML):
 *
 *   nextflow run workflows/rnaseq -config config/ZJOU2023_HEAT.config \
 *     -profile local,workstation
 *
 * Secondary comparison (mantle):
 *
 *   nextflow run workflows/rnaseq -config config/ZJOU2023_HEAT.config \
 *     -profile local,workstation --comparison_id heat_30c_vs_18c_mantle \
 *     --control_level M_C --treatment_level M_H
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA954971 --study ZJOU2023_HEAT \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<tissue_code>[GM])(?P<temp_code>[CH])(?P<rep>[123])$' \
 *     --condition-attribute tissue_code --condition-attribute temp_code \
 *     --attribute temp --attribute tissue --attribute age \
 *     --library-strategy RNA-Seq --out data/studies/ZJOU2023_HEAT
 *
 * The reference bundle comes from `aree fetch-reference --assembly GCF_965363235.1`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'ZJOU2023_HEAT'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_965363235.1'
        annotation_version = 'GCF_965363235.1-RS_2025_08'
        processed_results  = null
    }

    comparison_id = 'heat_30c_vs_18c_gill'

    sample_sheet = 'data/studies/ZJOU2023_HEAT/samplesheet.tsv'

    control_level   = 'G_C'
    treatment_level = 'G_H'

    // FASTQ are not committed (28.5 GB for all 12 runs). Verify against ENA's
    // MD5s in data/studies/ZJOU2023_HEAT/fastq_manifest.tsv.
    reads = 'data/raw/ZJOU2023_HEAT/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_965363235.1/rna.fna'
    gtf              = 'data/reference/GCF_965363235.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_965363235.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/ZJOU2023_HEAT'
}

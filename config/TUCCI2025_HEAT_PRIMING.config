/*
 * AREE :: run configuration for TUCCI2025_HEAT_PRIMING (PRJNA1132140)
 *
 * The libraries are Lexogen QuantSeq 3' Tag-Seq (75 bp single-end), so the
 * run uses --tag_seq (PR #24): fastp trims poly(A) tails, Salmon runs with
 * --noLengthCorrection, and DESeq2 fits counts without length offsets. Without
 * it, length offsets can create false fold changes from isoform switching
 * (workflows/rnaseq/README.md, "3' Tag-seq libraries"). Tank is still not
 * modelled; see limitations (2) in registry/studies/TUCCI2025_HEAT_PRIMING.yaml.
 *
 * The prespecified primary comparison is set below (naive clams, heatwave vs
 * control). For the second comparison:
 *   --comparison_id primed_hw_vs_naive_hw \
 *   --control_level Naïve_Heatwave --treatment_level Primed_Heatwave
 *
 *   nextflow run workflows/rnaseq -config config/TUCCI2025_HEAT_PRIMING.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA1132140 --study TUCCI2025_HEAT_PRIMING \
 *     --condition-attribute Treatment --condition-attribute "Thermal stress" \
 *     --attribute Clam_ID --library-strategy RNA-Seq
 *
 * The reference bundle comes from `aree fetch-reference --assembly ASM2657151v2`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode       = 'raw_reanalysis'
    single_end = true
    tag_seq    = true   // QuantSeq 3' Tag-Seq: no length correction anywhere

    rnaseq {
        study_id           = 'TUCCI2025_HEAT_PRIMING'
        // Null so --comparison_id on the command line takes effect: the
        // workflow reads rnaseq.comparison_id first, and a value here would
        // name every comparison's output after the primary one.
        comparison_id      = null
        genome_assembly    = 'GCF_026571515.1'
        annotation_version = 'GCF_026571515.1-RS_2023_10'
        processed_results  = null
    }

    // Prespecified primary comparison (meta_analysis_primary in the study YAML).
    comparison_id = 'naive_hw_vs_naive_control'

    sample_sheet = 'data/studies/TUCCI2025_HEAT_PRIMING/samplesheet.tsv'

    // Condition levels are Treatment x Thermal stress from the BioSamples.
    control_level   = 'Naïve_No_Heatwave'
    treatment_level = 'Naïve_Heatwave'

    // Tank is the unit of treatment (2 tanks per condition), but tank IDs are
    // not deposited, so replicate_unit cannot be set. The study carries
    // tank_level_replication; see limitations (2).

    // FASTQ are not committed (13.8 GB for the 40 RNA-seq runs). Verify
    // against ENA's MD5s in data/studies/TUCCI2025_HEAT_PRIMING/fastq_manifest.tsv.
    // Single-end: one file per run, sample id = run accession.
    reads = 'data/raw/TUCCI2025_HEAT_PRIMING/SRR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_026571515.1/rna.fna'
    gtf              = 'data/reference/GCF_026571515.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_026571515.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/TUCCI2025_HEAT_PRIMING'
}

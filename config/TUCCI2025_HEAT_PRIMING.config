/*
 * AREE :: run configuration for TUCCI2025_HEAT_PRIMING (PRJNA1132140)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/TUCCI2025_HEAT_PRIMING.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA1132140 --study TUCCI2025_HEAT_PRIMING --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/TUCCI2025_HEAT_PRIMING/samplesheet.tsv'
    reads        = 'data/raw/TUCCI2025_HEAT_PRIMING/*_{1,2}.fastq.gz'
    outdir       = 'results/TUCCI2025_HEAT_PRIMING'
}

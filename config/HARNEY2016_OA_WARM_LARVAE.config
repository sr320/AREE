/*
 * AREE :: run configuration for HARNEY2016_OA_WARM_LARVAE (PXD002316)
 *
 * NOT RUN. Registered only (2026-10-17): a 2-DE study whose spot volumes and
 * gel images were never deposited, so there is nothing for the proteomics
 * workflow to read. See registry/studies/HARNEY2016_OA_WARM_LARVAE.yaml.
 */

includeConfig 'base.config'

params {
    mode   = 'processed_results_harmonization'
    outdir = 'results/HARNEY2016_OA_WARM_LARVAE'

    proteomics {
        study_id      = 'HARNEY2016_OA_WARM_LARVAE'
        comparison_id = 'ph7_9_vs_ph8_1_at_20c'
    }
}

/*
 * AREE :: run configuration for DECICOMP2025_POMS_AGE_EMSEQ (PRJEB105019)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/DECICOMP2025_POMS_AGE_EMSEQ.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJEB105019 --study DECICOMP2025_POMS_AGE_EMSEQ --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/DECICOMP2025_POMS_AGE_EMSEQ/samplesheet.tsv'
    reads        = 'data/raw/DECICOMP2025_POMS_AGE_EMSEQ/*_{1,2}.fastq.gz'
    outdir       = 'results/DECICOMP2025_POMS_AGE_EMSEQ'
}

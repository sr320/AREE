/*
 * AREE :: run configuration for DECICOMP2025_POMS_AGE_EMSEQ (PRJEB105019)
 *
 * EM-seq of whole individual oysters from the Ifremer DECICOMP POMS age
 * experiment: families F14R and H2D, 4/16/28 months at 0 hpc (basal), plus
 * resistant and susceptible 28-month oysters at 500 hpc. Three registered
 * comparisons (sample-sheet `condition` = <cohort>_<group>):
 *
 *   age28mo_vs_age4mo_basal                 C3_T0 (0) vs C8_T0 (1)   primary
 *   age16mo_vs_age4mo_basal                 C3_T0 (0) vs C7_T0 (1)
 *   resistant_vs_susceptible_28mo_500hpc    C8_S  (0) vs C8_R  (1)
 *
 *   nextflow run workflows/methylation \
 *     -config config/DECICOMP2025_POMS_AGE_EMSEQ.config \
 *     -profile local,workstation
 *
 * methylkit_samplesheet.csv codes the primary comparison only. For the other
 * two, regenerate it with `--methylkit-levels C3_T0 C7_T0` or
 * `--methylkit-levels C8_S C8_R`, and set comparison_id to match.
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJEB105019 \
 *     --study DECICOMP2025_POMS_AGE_EMSEQ \
 *     --label-field experiment_title \
 *     --label-pattern '(?P<family>F14R|H2D)_(?P<cohort>C[378])_(?P<group>T0|R|S)_S(?P<replicate>[1-6])$' \
 *     --condition-attribute cohort --condition-attribute group \
 *     --attribute family --attribute replicate --attribute phenotype \
 *     --attribute age --attribute isolate --attribute tissue_type \
 *     --methylkit-levels C3_T0 C8_T0
 *
 * REPLICATION. Each library is one whole oyster, and each arm holds 6 per
 * family from both families, so individuals are the replicates and no
 * replicate_unit is set. DMR_METHYLKIT has no covariate term, so family adds
 * unmodeled variance (balanced across arms). Run each family alone as a
 * sensitivity analysis.
 *
 * NOT YET RUN. 60 paired-end NovaSeq libraries, about 174 M read pairs each,
 * 710.5 GB of FASTQ. That will not fit beside the other studies on Monarch
 * (167 GB free on 2026-10-13); stage it on a drive with room. EM-seq is
 * directional, so Bismark's default directional mode applies; check M-bias
 * before setting extractor_args.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    // AREE reanalyzes against its current reference. Bismark needs the genome
    // FASTA, which is not yet staged next to rna.fna/genomic.gtf on Monarch.
    genome_assembly = 'GCF_963853765.1'
    genome_fasta    = 'data/reference/GCF_963853765.1/genomic.fna'
    annotation_gtf  = 'data/reference/GCF_963853765.1/genomic.gtf'

    // FASTQ are not committed (710.5 GB). Verify against
    // data/studies/DECICOMP2025_POMS_AGE_EMSEQ/fastq_manifest.tsv MD5s.
    // ERR15996548 comes from the submitter's files (source = submitted_ftp,
    // ..._DNA_R1/_R2.fastq.gz): save them as ERR15996548_{1,2}.fastq.gz by
    // the manifest's run_accession and mate so this glob picks them up.
    reads = 'data/raw/DECICOMP2025_POMS_AGE_EMSEQ/ERR*_{1,2}.fastq.gz'

    methylation {
        study_id          = 'DECICOMP2025_POMS_AGE_EMSEQ'
        comparison_id     = 'age28mo_vs_age4mo_basal'
        processed_results = null

        // C3_T0 = 0 (reference, 4 months), C8_T0 = 1 (28 months), keyed by run.
        sample_sheet = 'data/studies/DECICOMP2025_POMS_AGE_EMSEQ/methylkit_samplesheet.csv'

        // Permissive score_min, as for CIBNOR2021_HEAT_RRSS: the M. gigas genome
        // is highly heterozygous (L,0,-0.6 mapped 53.9% vs 15.5% at default).
        bismark_align_args = '--score_min L,0,-0.6'
    }

    outdir = 'results/methylation/DECICOMP2025_POMS_AGE_EMSEQ'

    // Trimmed reads and BAMs are hundreds of GB: symlink, never copy.
    publish_mode = 'symlink'
}

process {
    // About 2.5x the per-library depth of CIBNOR2021_HEAT_RRSS.
    withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '32 GB'; time = '6h'  }
    withName: 'BISMARK_ALIGN'                 { cpus = 12; memory = '48 GB'; time = '48h' }
    withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '24 GB'; time = '12h' }
    withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 8;  memory = '16 GB'; time = '24h' }
    withName: 'TRIM_GALORE'                   { cpus = 4;  memory = '8 GB';  time = '8h'  }
    withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '32 GB'; time = '12h' }
}

/*
 * AREE :: run configuration for WANG2026_ERK_HEAT (PXD065668)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/WANG2026_ERK_HEAT.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PXD065668 --study WANG2026_ERK_HEAT --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/WANG2026_ERK_HEAT/samplesheet.tsv'
    reads        = 'data/raw/WANG2026_ERK_HEAT/*_{1,2}.fastq.gz'
    outdir       = 'results/WANG2026_ERK_HEAT'
}

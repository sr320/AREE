includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/WANG2026_ERK_HEAT'

    proteomics {
        study_id      = 'WANG2026_ERK_HEAT'
        comparison_id = 'heat_12h_vs_0h_seawater'
    }
}

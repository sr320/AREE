/*
 * AREE :: run configuration for NORTHSOUTH2024_TEMP_GILL (PRJNA738278)
 *
 * Full-length paired-end libraries (HiSeq 2500, library_selection RANDOM),
 * so the standard RNA-seq path applies: no tag_seq, Salmon length correction
 * and DESeq2 length offsets on.
 *
 * The sample sheet's `condition` is the temperature code from the sample
 * aliases: 1 = -1 C, 2 = 12 C, 3 = 28 C. Population (G = South, Guangxi;
 * J = North, Golden Pebble Beach) is fitted as a covariate
 * (~ population + condition). Libraries not in the two levels compared are
 * left out of the fit.
 *
 *   nextflow run workflows/rnaseq -config config/NORTHSOUTH2024_TEMP_GILL.config \
 *     -profile local,workstation
 *
 * and for the secondary cold comparison:
 *
 *   nextflow run workflows/rnaseq -config config/NORTHSOUTH2024_TEMP_GILL.config \
 *     -profile local,workstation --comparison_id cold_minus1c_vs_12c \
 *     --control_level 2 --treatment_level 1
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA738278 --study NORTHSOUTH2024_TEMP_GILL \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<population>[GJ])(?P<temp>[123])S(?P<rep>[123])$' \
 *     --condition-attribute temp --attribute population \
 *     --attribute isolation_source --library-strategy RNA-Seq \
 *     --out data/studies/NORTHSOUTH2024_TEMP_GILL
 *
 * The reference bundle comes from `aree fetch-reference --assembly ASM2657151v2`
 * (docs/reference_bundles.md), shared with the other Manila clam studies.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'NORTHSOUTH2024_TEMP_GILL'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_026571515.1'
        annotation_version = 'GCF_026571515.1-RS_2023_10'
        processed_results  = null
    }

    // Prespecified primary comparison (meta_analysis_primary in the study YAML).
    comparison_id = 'heat_28c_vs_12c'

    sample_sheet = 'data/studies/NORTHSOUTH2024_TEMP_GILL/samplesheet.tsv'

    // 12 C (code 2) vs 28 C (code 3).
    control_level   = '2'
    treatment_level = '3'

    covariates = 'population'

    // FASTQ are not committed (55.2 GB for all 18 runs; about 37 GB for the
    // 12 runs at 12 and 28 C). Verify against ENA's MD5s in
    // data/studies/NORTHSOUTH2024_TEMP_GILL/fastq_manifest.tsv.
    reads = 'data/raw/NORTHSOUTH2024_TEMP_GILL/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_026571515.1/rna.fna'
    gtf              = 'data/reference/GCF_026571515.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_026571515.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/NORTHSOUTH2024_TEMP_GILL'
}

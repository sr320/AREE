/*
 * AREE :: run configuration for UW2016_HEATSHOCK_MANTLE (PRJNA316154)
 *
 * Three adult oysters, mantle before (C, 15 C) and after a 1 h heat shock at
 * 40 C (HS). Paired: fitted as ~ oyster + condition. Single-end 101 bp.
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/UW2016_HEATSHOCK_MANTLE.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA316154 --study UW2016_HEATSHOCK_MANTLE \
 *     --label-field sample_alias --label-pattern '^(?P<oyster>[246]M)-(?P<treatment>C|HS)$' \
 *     --condition-attribute treatment --attribute oyster --attribute tissue \
 *     --attribute collection_date --attribute geo_loc_name --attribute isolation_source
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'UW2016_HEATSHOCK_MANTLE'
        // Keep null: the workflow reads rnaseq.comparison_id before
        // --comparison_id (see LI2022_HEAT_PLOIDY).
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'heat_shock_40c_1h_vs_control'

    sample_sheet = 'data/studies/UW2016_HEATSHOCK_MANTLE/samplesheet.tsv'

    control_level   = 'C'
    treatment_level = 'HS'

    // Paired design: each oyster sampled before and after the heat shock.
    covariates = 'oyster'

    // Single-end; sample ids are the file-name stems (run accessions).
    single_end = true
    reads      = 'data/raw/UW2016_HEATSHOCK_MANTLE/SRR*.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/UW2016_HEATSHOCK_MANTLE'
}

process {
    // 6 HiSeq 2500 single-end 101 bp libraries, 18.8-28.9 M reads each.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

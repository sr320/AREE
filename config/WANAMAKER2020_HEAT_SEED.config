/*
 * AREE :: run configuration for WANAMAKER2020_HEAT_SEED (PXD013262)
 *
 * NOT RUN. The study failed QC at registration (2026-10-17): one silo per
 * temperature and technical-duplicate MS runs only, so there is no biological
 * replication to test against. See registry/studies/WANAMAKER2020_HEAT_SEED.yaml.
 *
 * If the design question is ever reopened (e.g. the unpublished 23 C Silo 2
 * samples turn up), the input would be the figshare Abacus_output.tsv adjusted
 * NSAF columns reshaped to a protein_accession x run matrix, plus a
 * sample_id/group sheet derived from samplesheet.tsv, run with
 *
 *   nextflow run workflows/proteomics -config config/WANAMAKER2020_HEAT_SEED.config -profile local
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/WANAMAKER2020_HEAT_SEED'

    proteomics {
        study_id      = 'WANAMAKER2020_HEAT_SEED'
        comparison_id = 'temp29_vs_temp23_days3to13'
    }
}

/*
 * AREE :: run configuration for WANAMAKER2020_HEAT_SEED (PXD013262)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/WANAMAKER2020_HEAT_SEED.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PXD013262 --study WANAMAKER2020_HEAT_SEED --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/WANAMAKER2020_HEAT_SEED/samplesheet.tsv'
    reads        = 'data/raw/WANAMAKER2020_HEAT_SEED/*_{1,2}.fastq.gz'
    outdir       = 'results/WANAMAKER2020_HEAT_SEED'
}

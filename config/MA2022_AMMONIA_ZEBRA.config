/*
 * AREE :: run configuration for MA2022_AMMONIA_ZEBRA (PRJNA733332)
 *
 * Manila clam, Zebra II strain (B) vs ordinary clams (P), each unexposed (D)
 * or after a 96 h total-ammonia-nitrogen challenge (C96); 3 whole juveniles
 * per cell, full-length paired-end HiSeq 2500 libraries, so the standard
 * length-aware path (no tag_seq).
 *
 * Four prespecified two-level comparisons (registry/studies/MA2022_AMMONIA_ZEBRA.yaml).
 * The defaults below run the exposure_response primary; run the others with
 * command-line overrides:
 *
 *   comparison_id                          control_level  treatment_level
 *   ordinary_tan96h_vs_ordinary_control    P_D            P_C96   (default)
 *   zebra_tan96h_vs_zebra_control          B_D            B_C96
 *   zebra_vs_ordinary_control              P_D            B_D
 *   zebra_vs_ordinary_tan96h               P_C96          B_C96
 *
 *   nextflow run workflows/rnaseq -config config/MA2022_AMMONIA_ZEBRA.config \
 *     -profile local,workstation \
 *     --comparison_id zebra_vs_ordinary_control --control_level P_D --treatment_level B_D
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA733332 --study MA2022_AMMONIA_ZEBRA \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<strain>[BP])(?P<tan>D|C96)_(?P<rep>[123])$' \
 *     --condition-attribute strain --condition-attribute tan \
 *     --attribute isolate --attribute tissue --attribute collection_date \
 *     --library-strategy RNA-Seq
 *
 * The reference bundle comes from `aree fetch-reference --assembly ASM2657151v2`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode       = 'raw_reanalysis'
    single_end = false

    rnaseq {
        study_id           = 'MA2022_AMMONIA_ZEBRA'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_026571515.1'
        annotation_version = 'GCF_026571515.1-RS_2023_10'
        processed_results  = null
    }

    // Prespecified exposure_response primary (meta_analysis_primary in the YAML).
    comparison_id = 'ordinary_tan96h_vs_ordinary_control'

    sample_sheet = 'data/studies/MA2022_AMMONIA_ZEBRA/samplesheet.tsv'

    // Condition levels are <strain>_<treatment> from the sample aliases.
    control_level   = 'P_D'
    treatment_level = 'P_C96'

    // FASTQ are not committed (38.7 GB). Verify against ENA's MD5s in
    // data/studies/MA2022_AMMONIA_ZEBRA/fastq_manifest.tsv.
    reads = 'data/raw/MA2022_AMMONIA_ZEBRA/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_026571515.1/rna.fna'
    gtf              = 'data/reference/GCF_026571515.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_026571515.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/MA2022_AMMONIA_ZEBRA'
}

/*
 * AREE :: run configuration for MA2022_AMMONIA_ZEBRA (PRJNA733332)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/MA2022_AMMONIA_ZEBRA.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA733332 --study MA2022_AMMONIA_ZEBRA --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/MA2022_AMMONIA_ZEBRA/samplesheet.tsv'
    reads        = 'data/raw/MA2022_AMMONIA_ZEBRA/*_{1,2}.fastq.gz'
    outdir       = 'results/MA2022_AMMONIA_ZEBRA'
}

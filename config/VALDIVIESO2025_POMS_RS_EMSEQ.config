/*
 * AREE :: run configuration for VALDIVIESO2025_POMS_RS_EMSEQ (PRJEB81880)
 *
 * EM-seq of gill and mantle biopsies from 10 individual oysters (one resistant
 * and one susceptible from each of 5 F1 populations), each biopsied before
 * (T0) and after (T1) an experimental POMS cohabitation challenge.
 * Valdivieso et al. 2025, Sci Total Environ 962:178385. Eight registered
 * comparisons (sample-sheet `condition` = <tissue>_<phenotype>_<time>):
 *
 *   resistant_vs_susceptible_gill_t0     G_S_T0 (0) vs G_R_T0 (1)  baseline, primary
 *   resistant_vs_susceptible_mantle_t0   M_S_T0 (0) vs M_R_T0 (1)  baseline
 *   resistant_vs_susceptible_gill_t1     G_S_T1 (0) vs G_R_T1 (1)  under exposure, primary
 *   resistant_vs_susceptible_mantle_t1   M_S_T1 (0) vs M_R_T1 (1)  under exposure
 *   susceptible_t1_vs_t0_gill            G_S_T0 (0) vs G_S_T1 (1)  exposure response, primary
 *   resistant_t1_vs_t0_gill              G_R_T0 (0) vs G_R_T1 (1)  exposure response
 *   susceptible_t1_vs_t0_mantle          M_S_T0 (0) vs M_S_T1 (1)  exposure response
 *   resistant_t1_vs_t0_mantle            M_R_T0 (0) vs M_R_T1 (1)  exposure response
 *
 *   nextflow run workflows/methylation \
 *     -config config/VALDIVIESO2025_POMS_RS_EMSEQ.config \
 *     -profile local,workstation
 *
 * methylkit_samplesheet.csv codes the primary baseline comparison only. For
 * the others, regenerate it with the matching `--methylkit-levels` pair from
 * the table above, and set comparison_id to match.
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJEB81880 \
 *     --study VALDIVIESO2025_POMS_RS_EMSEQ \
 *     --label-field experiment_title \
 *     --label-pattern '(?P<population>GT[1-5])_(?P<code>\d{2})_(?P<time>T[01])_(?P<tissue_code>[GM])_(?P<phenotype_class>[RS])$' \
 *     --condition-attribute tissue_code --condition-attribute phenotype_class \
 *     --condition-attribute time \
 *     --attribute population --attribute code --attribute phenotype \
 *     --attribute tissue_type --attribute age --attribute sample_description \
 *     --methylkit-levels G_S_T0 G_R_T0
 *
 * REPLICATION. Each library is one biopsy of one individual oyster, and within
 * any single comparison the 10 libraries are 10 distinct biopsies, so
 * individuals are the replicates and no replicate_unit is set. The design is
 * PAIRED, which the DMR engines do not yet model: R and S are matched by
 * population (population is the main axis of variation in the paper's PCA),
 * and T1 vs T0 compares the same 5 animals. As configured, the contrast is
 * unpaired. A population block / animal pairing term needs a workflow change
 * in its own PR before these results are final; until then, report the
 * unpaired fit as such.
 *
 * BEFORE RUNNING. Check genotype concordance across each animal's four
 * libraries (T0/T1 x gill/mantle): oyster code 21 is used for both the
 * resistant and the susceptible population-4 animal (see the YAML
 * limitations).
 *
 * NOT YET RUN. 40 paired-end NovaSeq libraries, ENA read_count 148-336 M per
 * run, 624.9 GB of FASTQ. Stage on a drive with room. EM-seq is directional,
 * so Bismark's default directional mode applies; check M-bias before setting
 * extractor_args. The paper trimmed 5 bp from the 5' end of both reads.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    // AREE reanalyzes against its current reference (the paper used
    // cgigas_uk_roslin_v1). Bismark needs the genome FASTA.
    genome_assembly = 'GCF_963853765.1'
    genome_fasta    = 'data/reference/GCF_963853765.1/genomic.fna'
    annotation_gtf  = 'data/reference/GCF_963853765.1/genomic.gtf'

    // FASTQ are not committed (624.9 GB). Verify against
    // data/studies/VALDIVIESO2025_POMS_RS_EMSEQ/fastq_manifest.tsv MD5s.
    // All 40 runs have ENA-generated FASTQ.
    reads = 'data/raw/VALDIVIESO2025_POMS_RS_EMSEQ/ERR*_{1,2}.fastq.gz'

    methylation {
        study_id          = 'VALDIVIESO2025_POMS_RS_EMSEQ'
        comparison_id     = 'resistant_vs_susceptible_gill_t0'
        processed_results = null

        // G_S_T0 = 0 (reference, later susceptible), G_R_T0 = 1 (later
        // resistant), keyed by run.
        sample_sheet = 'data/studies/VALDIVIESO2025_POMS_RS_EMSEQ/methylkit_samplesheet.csv'

        // Permissive score_min, as for CIBNOR2021_HEAT_RRSS and
        // DECICOMP2025_POMS_AGE_EMSEQ: the M. gigas genome is highly
        // heterozygous (L,0,-0.6 mapped 53.9% vs 15.5% at default). The paper
        // used L,0,-0.4 and reports 43% mapping.
        bismark_align_args = '--score_min L,0,-0.6'
    }

    outdir = 'results/methylation/VALDIVIESO2025_POMS_RS_EMSEQ'

    // Trimmed reads and BAMs are hundreds of GB: symlink, never copy.
    publish_mode = 'symlink'
}

process {
    // Per-library depth similar to DECICOMP2025_POMS_AGE_EMSEQ.
    withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '32 GB'; time = '6h'  }
    withName: 'BISMARK_ALIGN'                 { cpus = 12; memory = '48 GB'; time = '48h' }
    withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '24 GB'; time = '12h' }
    withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 8;  memory = '16 GB'; time = '24h' }
    withName: 'TRIM_GALORE'                   { cpus = 4;  memory = '8 GB';  time = '8h'  }
    withName: 'DMR_METHYLKIT'                 { cpus = 4;  memory = '32 GB'; time = '12h' }
}

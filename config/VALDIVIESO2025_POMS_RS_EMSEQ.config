/*
 * AREE :: run configuration for VALDIVIESO2025_POMS_RS_EMSEQ (PRJEB81880)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/VALDIVIESO2025_POMS_RS_EMSEQ.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJEB81880 --study VALDIVIESO2025_POMS_RS_EMSEQ --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/VALDIVIESO2025_POMS_RS_EMSEQ/samplesheet.tsv'
    reads        = 'data/raw/VALDIVIESO2025_POMS_RS_EMSEQ/*_{1,2}.fastq.gz'
    outdir       = 'results/VALDIVIESO2025_POMS_RS_EMSEQ'
}

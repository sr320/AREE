/*
 * AREE :: run configuration for ZENG2024_SALINITY_GILL (PRJNA1159784)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/ZENG2024_SALINITY_GILL.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJNA1159784 --study ZENG2024_SALINITY_GILL --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/ZENG2024_SALINITY_GILL/samplesheet.tsv'
    reads        = 'data/raw/ZENG2024_SALINITY_GILL/*_{1,2}.fastq.gz'
    outdir       = 'results/ZENG2024_SALINITY_GILL'
}

/*
 * AREE :: run configuration for ZENG2024_SALINITY_GILL (PRJNA1159784)
 *
 * Hard clam (Mercenaria mercenaria), University of Florida, gill. Three months
 * at 15 ppt (hyposalinity) or 35 ppt (hypersalinity) vs 25 ppt (control),
 * 3 clams per group, one clam per library. Paired-end NovaSeq X Plus
 * full-length libraries, so the standard RNA-seq path applies: no tag_seq,
 * Salmon length correction and DESeq2 length offsets on.
 *
 * Primary comparison (meta_analysis_primary in the study YAML):
 *
 *   nextflow run workflows/rnaseq -config config/ZENG2024_SALINITY_GILL.config \
 *     -profile local,workstation
 *
 * Secondary comparison (hypersalinity):
 *
 *   nextflow run workflows/rnaseq -config config/ZENG2024_SALINITY_GILL.config \
 *     -profile local,workstation --comparison_id hypersal_35_vs_25ppt \
 *     --control_level control --treatment_level hypersalinity
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA1159784 --study ZENG2024_SALINITY_GILL \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<group>control|hyposalinity|hypersalinity)_(?P<rep>[123])$' \
 *     --condition-attribute group --attribute env_broad_scale --attribute isolate \
 *     --attribute tissue --attribute collection_date \
 *     --library-strategy RNA-Seq --out data/studies/ZENG2024_SALINITY_GILL
 *
 * The reference bundle comes from `aree fetch-reference --assembly GCF_021730395.1`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'ZENG2024_SALINITY_GILL'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_021730395.1'
        annotation_version = 'GCF_021730395.1-RS_2023_01'
        processed_results  = null
    }

    comparison_id = 'hyposal_15_vs_25ppt'

    sample_sheet = 'data/studies/ZENG2024_SALINITY_GILL/samplesheet.tsv'

    control_level   = 'control'
    treatment_level = 'hyposalinity'

    // FASTQ are not committed (60.2 GB). Verify against ENA's MD5s in
    // data/studies/ZENG2024_SALINITY_GILL/fastq_manifest.tsv.
    reads = 'data/raw/ZENG2024_SALINITY_GILL/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_021730395.1/rna.fna'
    gtf              = 'data/reference/GCF_021730395.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_021730395.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/ZENG2024_SALINITY_GILL'
}

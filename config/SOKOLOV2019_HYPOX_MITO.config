/*
 * AREE :: run configuration for SOKOLOV2019_HYPOX_MITO (PXD011365)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/SOKOLOV2019_HYPOX_MITO.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PXD011365 --study SOKOLOV2019_HYPOX_MITO --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/SOKOLOV2019_HYPOX_MITO/samplesheet.tsv'
    reads        = 'data/raw/SOKOLOV2019_HYPOX_MITO/*_{1,2}.fastq.gz'
    outdir       = 'results/SOKOLOV2019_HYPOX_MITO'
}

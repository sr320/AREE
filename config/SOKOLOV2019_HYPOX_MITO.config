/*
 * AREE :: run configuration for SOKOLOV2019_HYPOX_MITO (PXD011365)
 *
 * NOT RUN. Registered only (2026-10-17): no phosphoproteome condition key,
 * total-proteome acquisition blocked by condition, and no per-sample abundance
 * table. See registry/studies/SOKOLOV2019_HYPOX_MITO.yaml.
 */

includeConfig 'base.config'

params {
    mode   = 'raw_reanalysis'
    outdir = 'results/SOKOLOV2019_HYPOX_MITO'

    proteomics {
        study_id      = 'SOKOLOV2019_HYPOX_MITO'
        comparison_id = 'hypoxia_24h_vs_normoxia'
    }
}

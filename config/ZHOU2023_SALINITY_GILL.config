/*
 * AREE :: run configuration for ZHOU2023_SALINITY_GILL (PRJNA975821)
 *
 * Hard clam (Mercenaria mercenaria), Tianjin, gill, 20 C. Chronic
 * hyposalinity (CL, 10 psu) and hypersalinity (CH, 45 psu) vs 30 psu (NS),
 * 3 libraries per group, each a pool of 3 clams. Paired-end NovaSeq 6000
 * full-length libraries, so the standard RNA-seq path applies: no tag_seq,
 * Salmon length correction and DESeq2 length offsets on.
 *
 * The sample sheet's `condition` is the alias group: NS, CL, CH, and the
 * acute groups AL1, AL5, AH1, AH5 (not analysed yet).
 *
 * Primary comparison (meta_analysis_primary in the study YAML):
 *
 *   nextflow run workflows/rnaseq -config config/ZHOU2023_SALINITY_GILL.config \
 *     -profile local,workstation
 *
 * Secondary comparison (hypersalinity):
 *
 *   nextflow run workflows/rnaseq -config config/ZHOU2023_SALINITY_GILL.config \
 *     -profile local,workstation --comparison_id chronic_hypersal_45_vs_30psu \
 *     --control_level NS --treatment_level CH
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJNA975821 --study ZHOU2023_SALINITY_GILL \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<group>NS|CL|CH|AL1|AL5|AH1|AH5)_(?P<rep>[123])$' \
 *     --condition-attribute group --attribute store_cond --attribute temp \
 *     --attribute sieving --attribute collection_date \
 *     --library-strategy RNA-Seq --out data/studies/ZHOU2023_SALINITY_GILL
 *
 * The reference bundle comes from `aree fetch-reference --assembly GCF_021730395.1`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'ZHOU2023_SALINITY_GILL'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_021730395.1'
        annotation_version = 'GCF_021730395.1-RS_2023_01'
        processed_results  = null
    }

    comparison_id = 'chronic_hyposal_10_vs_30psu'

    sample_sheet = 'data/studies/ZHOU2023_SALINITY_GILL/samplesheet.tsv'

    control_level   = 'NS'
    treatment_level = 'CL'

    // FASTQ are not committed (52.5 GB for all 21 runs). Verify against ENA's
    // MD5s in data/studies/ZHOU2023_SALINITY_GILL/fastq_manifest.tsv.
    reads = 'data/raw/ZHOU2023_SALINITY_GILL/SRR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_021730395.1/rna.fna'
    gtf              = 'data/reference/GCF_021730395.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_021730395.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/ZHOU2023_SALINITY_GILL'
}

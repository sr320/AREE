/*
 * AREE :: run configuration for ZHONG2025_PONV1_MORTALITY (PRJEB77044)
 *
 * Farmed adults during a 2020 mass-mortality event vs apparently healthy wild
 * oysters, British Columbia. 96 metatranscriptomes at ~175-200 M read pairs
 * each (792.6 GB). Meant for a machine with external storage (claimed for
 * Chlo); stage only the comparison being run.
 *
 * Default comparison: mantle, farm (StnI, StnL) vs wild (10 stations):
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/ZHONG2025_PONV1_MORTALITY.config \
 *     -profile local,workstation
 *
 * Hemolymph:
 *   --comparison_id farm_mortality_vs_wild_hemolymph \
 *   --control_level StnA_Hemolymph,StnC_Hemolymph,StnD_Hemolymph,StnE_Hemolymph,StnF_Hemolymph,StnG_Hemolymph,StnH_Hemolymph,StnJ_Hemolymph,StnK_Hemolymph \
 *   --treatment_level StnI_Hemolymph,StnL_Hemolymph,StnM_Hemolymph
 *
 * Viral QC for the planned within-farm PONV1 comparison: add the PONV1
 * genome (both segments) under data/reference/pathogens/PONV1/ and pass
 * --viral_reference (see the study YAML header for the prespecified rule).
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJEB77044 --study ZHONG2025_PONV1_MORTALITY \
 *     --label-field sample_alias \
 *     --label-pattern '^(?P<station>Stn[A-M])_(?P<tissue_label>Mantle|Hemolymph)_(?P<oyster>[A-M][0-9]+)$' \
 *     --condition-attribute station --condition-attribute tissue_label \
 *     --attribute oyster --attribute 'collection date' \
 *     --attribute 'geographic location (country and/or sea)'
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'ZHONG2025_PONV1_MORTALITY'
        // Keep null: the workflow reads rnaseq.comparison_id before
        // --comparison_id (see LI2022_HEAT_PLOIDY).
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    comparison_id = 'farm_mortality_vs_wild_mantle'

    // Condition levels are <station>_<Mantle|Hemolymph>.
    sample_sheet = 'data/studies/ZHONG2025_PONV1_MORTALITY/samplesheet.tsv'

    control_level   = 'StnA_Mantle,StnB_Mantle,StnC_Mantle,StnD_Mantle,StnE_Mantle,StnF_Mantle,StnG_Mantle,StnH_Mantle,StnJ_Mantle,StnK_Mantle'
    treatment_level = 'StnI_Mantle,StnL_Mantle'

    // FASTQ are not committed. Stage only the libraries of the comparison
    // being run and verify them against fastq_manifest.tsv.
    reads = 'data/raw/ZHONG2025_PONV1_MORTALITY/ERR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    // Total-RNA libraries: rRNA is 65-97% of gene counts. Keep it out of the
    // results and record each library's share (needs PR #57's --exclude_genes).
    exclude_genes    = 'data/reference/gene_lists/GCF_963853765.1-RS_2024_06_rRNA.txt'

    outdir = 'results/rnaseq/ZHONG2025_PONV1_MORTALITY'
}

process {
    // ~190 M read pairs per library: trimming and quantification take longer
    // than for the other studies.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '6h'  }
    withName: 'TRIM_FASTP'   { cpus = 8;  memory = '16 GB'; time = '8h'  }
    withName: 'FASTQC'       { cpus = 4;  memory = '8 GB';  time = '6h'  }
}

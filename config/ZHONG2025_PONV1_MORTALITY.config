/*
 * AREE :: run configuration for ZHONG2025_PONV1_MORTALITY (PRJEB77044)
 *
 * Claimed with `aree start-study`. Fill in params for the workflow this
 * study runs (see config/IOCAS2022_OA_ENERGY.config for RNA-seq and
 * config/CIBNOR2021_HEAT_RRSS.config for methylation), then
 *
 *   nextflow run workflows/<assay> -config config/ZHONG2025_PONV1_MORTALITY.config -profile local,workstation
 *
 * Generate the sample sheet and FASTQ manifest rather than writing them:
 *
 *   aree fetch-samplesheet --bioproject PRJEB77044 --study ZHONG2025_PONV1_MORTALITY --condition-attribute <attr>
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    sample_sheet = 'data/studies/ZHONG2025_PONV1_MORTALITY/samplesheet.tsv'
    reads        = 'data/raw/ZHONG2025_PONV1_MORTALITY/*_{1,2}.fastq.gz'
    outdir       = 'results/ZHONG2025_PONV1_MORTALITY'
}

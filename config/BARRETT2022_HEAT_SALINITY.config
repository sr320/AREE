/*
 * AREE :: run configuration for BARRETT2022_HEAT_SALINITY (PRJEB48959)
 *
 * Full-length paired-end RNA-seq (Illumina NovaSeq 6000, PE150, Novogene), so
 * the standard path applies: no tag_seq. Reads map to the RefSeq Mytilus
 * edulis annotation (xbMytEdul2.2, GCF_963676685.1). The study is in the
 * hybridizing M. edulis complex and carries species_assignment_unverified; see
 * registry/studies/BARRETT2022_HEAT_SALINITY.yaml.
 *
 * The thermal primary comparison is set below (33 C vs 5 C air, both at 23 per
 * mille). The salinity primary and the two unpooled comparisons:
 *   --comparison_id low_salinity_15_vs_control \
 *     --control_level 23_percent_salinity_5 --treatment_level 15_percent_salinity_5
 *   --comparison_id heat_30c_vs_control \
 *     --control_level 23_percent_salinity_5 --treatment_level 23_percent_salinity_30
 *   --comparison_id very_low_salinity_5_vs_control \
 *     --control_level 23_percent_salinity_5 --treatment_level 5_percent_salinity_5
 *
 *   nextflow run workflows/rnaseq -config config/BARRETT2022_HEAT_SALINITY.config \
 *     -profile local,workstation
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *   aree fetch-samplesheet --bioproject PRJEB48959 --study BARRETT2022_HEAT_SALINITY \
 *     --condition-attribute "environmental stress" --condition-attribute temperature \
 *     --attribute individual --library-strategy RNA-Seq
 *
 * The reference bundle comes from `aree fetch-reference --assembly xbMytEdul2.2`
 * (docs/reference_bundles.md).
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'BARRETT2022_HEAT_SALINITY'
        // Null so a --comparison_id on the command line takes effect.
        comparison_id      = null
        genome_assembly    = 'GCF_963676685.1'
        annotation_version = 'GCF_963676685.1-RS_2025_02'
        processed_results  = null
    }

    // Prespecified thermal primary comparison (meta_analysis_primary in the study YAML).
    comparison_id = 'heat_33c_vs_control'

    sample_sheet = 'data/studies/BARRETT2022_HEAT_SALINITY/samplesheet.tsv'

    // Condition levels combine the BioSample attributes "environmental stress"
    // (salinity) and "temperature" (air temperature, C).
    control_level   = '23_percent_salinity_5'
    treatment_level = '23_percent_salinity_33'

    // FASTQ are not committed (109.3 GB for all 35 libraries; only registered
    // comparisons' libraries need staging). Verify against ENA's MD5s in
    // data/studies/BARRETT2022_HEAT_SALINITY/fastq_manifest.tsv.
    reads = 'data/raw/BARRETT2022_HEAT_SALINITY/ERR*_{1,2}.fastq.gz'

    transcript_fasta = 'data/reference/GCF_963676685.1/rna.fna'
    gtf              = 'data/reference/GCF_963676685.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963676685.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/BARRETT2022_HEAT_SALINITY'
}

/*
 * AREE :: run configuration for DUPERRET2025_HEAT_RNASEQ (PRJEB86646 + PRJEB86525)
 *
 * 30 C vs 23 C before OsHV-1 challenge (Duperret et al. 2025, Sci Total
 * Environ). Single-end 75 bp, so `single_end = true`; fastp trims the
 * workflow's default TruSeq/NEBNext read-1 adapter.
 *
 * FIT ON TANKS. Both families share each tank, so their two libraries are
 * summed per tank before DESeq2 (--replicate_unit), giving 3 vs 3 units.
 *
 * Registered comparisons (sample-sheet `condition` = <treatment_code>_<hpc>;
 * code 3 = 23 C, 4 = 30 C):
 *
 *   heat30_vs_23c_0hpc           --control_level 3_0 --treatment_level 4_0  --replicate_unit tank
 *   heat30_oshv1_24hpc_vs_0hpc   --control_level 4_0 --treatment_level 4_24 --replicate_unit tank_hpc  (+ --viral_reference)
 *
 * The 23 C libraries are DUPERRET2025_STARVE_RNASEQ's fed arm. Their 0 and
 * 24 hpc reads are already staged under data/raw/DUPERRET2025_STARVE_RNASEQ/,
 * so point --reads at both folders or link them rather than downloading twice.
 * Only the 0 and 24 hpc libraries (24 of 84) are needed for the registered
 * comparisons.
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 * `aree fetch-samplesheet` was run once per BioProject and the outputs were
 * concatenated. The exact command is in the study YAML curation_notes.
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'DUPERRET2025_HEAT_RNASEQ'
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/DUPERRET2025_HEAT_RNASEQ/samplesheet.tsv'

    // Primary comparison, fitted on tanks.
    control_level   = '3_0'
    treatment_level = '4_0'
    replicate_unit  = 'tank'

    // FASTQ are not committed. Stage and checksum against
    // data/studies/DUPERRET2025_HEAT_RNASEQ/fastq_manifest.tsv (84 single-end
    // files, 106.1 GB). One file per run; sample ids are run accessions.
    reads      = 'data/raw/DUPERRET2025_HEAT_RNASEQ/ERR*.fastq.gz'
    single_end = true

    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    tx2gene          = 'data/reference/GCF_963853765.1/tx2gene.tsv'
    salmon_index     = null

    outdir = 'results/rnaseq/DUPERRET2025_HEAT_RNASEQ'
}

process {
    // Same 8-core / 16 GB sizing as DUPERRET2025_STARVE_RNASEQ.
    withName: 'SALMON_INDEX' { cpus = 8; memory = '12 GB'; time = '4h' }
    withName: 'SALMON_QUANT' { cpus = 6; memory = '8 GB';  time = '3h' }
    withName: 'VIRAL_QUANT'  { cpus = 4; memory = '4 GB';  time = '2h' }
    withName: 'TRIM_FASTP'   { cpus = 4; memory = '4 GB';  time = '3h' }
    withName: 'FASTQC'       { cpus = 2; memory = '2 GB';  time = '2h' }
    withName: 'DIFFERENTIAL_EXPRESSION_DESEQ2' { cpus = 2; memory = '8 GB'; time = '2h' }
}

/*
 * AREE :: run configuration for DELISLE2020_OSHV_TEMP (PRJNA593309)
 *
 * Independent real raw_reanalysis partner for the first real cross-study pool
 * with CALLA2026_OSHV. The initial registered comparison is a conservative
 * pathogen-challenge endpoint:
 *
 *   nextflow run workflows/rnaseq \
 *     -config config/DELISLE2020_OSHV_TEMP.config \
 *     -profile local \
 *     --comparison_id oshv1_21c_96h_vs_21c_0h
 *
 * The sample sheet and FASTQ manifest are generated, not hand-written:
 *
 *   aree fetch-samplesheet --bioproject PRJNA593309 \
 *     --study DELISLE2020_OSHV_TEMP \
 *     --condition-attribute temp \
 *     --condition-attribute time_post_infection \
 *     --attribute replicate_tanks \
 *     --attribute tissue \
 *     --attribute age
 */

includeConfig 'base.config'

params {
    mode = 'raw_reanalysis'

    rnaseq {
        study_id           = 'DELISLE2020_OSHV_TEMP'
        comparison_id      = null
        genome_assembly    = 'GCF_963853765.1'
        annotation_version = 'GCF_963853765.1-RS_2024_06'
        processed_results  = null
    }

    sample_sheet = 'data/studies/DELISLE2020_OSHV_TEMP/samplesheet.tsv'

    // Registered first comparison:
    //   --control_level 21_0 --treatment_level 21_96h
    control_level   = '21_0'
    treatment_level = '21_96h'

    // FASTQ are not committed. Stage and checksum using
    // data/studies/DELISLE2020_OSHV_TEMP/fastq_manifest.tsv.
    reads = 'data/raw/DELISLE2020_OSHV_TEMP/SRR*_{1,2}.fastq.gz'

    // Reuse AREE's current M. gigas reference annotation, matching the
    // identifier crosswalk and CALLA2026_OSHV reanalysis plan.
    transcript_fasta = 'data/reference/GCF_963853765.1/rna.fna'
    gtf              = 'data/reference/GCF_963853765.1/genomic.gtf'
    salmon_index     = null

    outdir = 'results/rnaseq/DELISLE2020_OSHV_TEMP'
}

process {
    // PRJNA593309 is smaller than CALLA2026_OSHV (~47 GB FASTQ in ENA), but
    // these are still full-depth paired RNA-seq libraries.
    withName: 'SALMON_INDEX' { cpus = 8;  memory = '32 GB'; time = '4h'  }
    withName: 'SALMON_QUANT' { cpus = 8;  memory = '16 GB'; time = '2h'  }
    withName: 'TRIM_FASTP'   { cpus = 4;  memory = '8 GB';  time = '2h'  }
    withName: 'FASTQC'       { cpus = 2;  memory = '4 GB';  time = '1h'  }
}

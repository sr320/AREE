// AREE :: RNA-seq workflow configuration
//
// STATUS: native raw pilot and processed mode executed; current-version CI
// covers processed mode and a stubbed raw DAG. Container profiles remain
// unverified. See README.md and ../../containers/README.md.

includeConfig '../../config/base.config'

params {
    // Mode switch: 'raw_reanalysis' or 'processed_results_harmonization'.
    // Default favors the mode that is actually demonstrable without real
    // FASTQ fixtures (see config/demo.config).
    mode = 'processed_results_harmonization'

    // Namespaced params consumed by main.nf; mirrors config/demo.config's
    // params.rnaseq.{processed_results,study_id,comparison_id} structure so
    // this workflow is directly compatible with `-config ../../config/demo.config`.
    rnaseq {
        processed_results = null
        study_id           = null
        comparison_id      = null
        genome_assembly    = null
        annotation_version = null
    }

    // Flat fallbacks (used if params.rnaseq.* is not set, e.g. when invoking
    // this workflow standalone with -profile demo instead of via demo.config).
    study_id          = null
    comparison_id     = null
    processed_results = null

    // raw_reanalysis-mode-only inputs (unused in processed_results_harmonization).
    reads            = null   // e.g. 'data/raw/GIGAS_HEAT01/*_R{1,2}.fastq.gz'
    salmon_index     = null   // path to a prebuilt Salmon index directory
    transcript_fasta = null   // used to build a Salmon index if salmon_index not given
    genome_fasta     = null   // reserved for STAR-based alternative alignment
    gtf              = null   // required for --geneMap gene-level Salmon quant
    tx2gene          = null   // transcript-to-gene TSV for tximport
    sample_sheet     = null   // TSV: sample_id, condition[, quant_subdir, covariates...]
    control_level    = null   // value of `condition` treated as the reference group
    treatment_level  = null   // value of `condition` contrasted against it

    outdir = 'results/rnaseq'
}

profiles {
    docker {
        docker.enabled       = true
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        docker.enabled          = false
    }

    local {
        docker.enabled    = false
        apptainer.enabled = false
        process.executor  = 'local'
    }

    ci_stub {
        process {
            withLabel: process_low {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
            withLabel: process_medium {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
            withLabel: process_high {
                cpus   = 2
                memory = 4.GB
                time   = 1.h
            }
        }
    }

    demo {
        // Convenience profile: run processed_results_harmonization mode
        // against the repository's synthetic demo TSV directly, without
        // needing to separately pass -config ../../config/demo.config.
        params.mode = 'processed_results_harmonization'
        params.rnaseq.processed_results = "${projectDir}/../../data/demo/rnaseq/GIGAS_HEAT01_acute_heat_vs_control_dge_demo.tsv"
        params.rnaseq.study_id          = 'GIGAS_HEAT01'
        params.rnaseq.comparison_id     = 'acute_heat_vs_control'
    }
}

manifest {
    name            = 'aree-rnaseq'
    author          = 'AREE contributors'
    homePage        = 'https://github.com/PLACEHOLDER_ORG/AREE'
    description     = 'AREE RNA-seq reanalysis / harmonization workflow scaffold'
    mainScript      = 'main.nf'
    version         = '0.1.0-scaffold'
    nextflowVersion = '>=23.10.0'
}

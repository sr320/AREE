// AREE methylation / WGBS / EM-seq workflow configuration
//
// STATUS: scaffold. Defines default params, container engine profiles, and
// includes the shared base config. Not tuned against a real run — see
// README.md "What has and has not been run".

includeConfig '../../config/base.config'

params {
    // 'raw_reanalysis' or 'processed_results_harmonization'. Default is the
    // mode that is actually runnable against the shipped demo data.
    mode = 'processed_results_harmonization'

    // Reference genome/annotation, used only in raw_reanalysis mode.
    genome_fasta     = null
    annotation_gtf   = null
    genome_assembly  = null

    // Paired-end bisulfite/EM-seq FASTQ glob, used only in raw_reanalysis
    // mode, e.g. 'data/raw/methylation/*_R{1,2}.fastq.gz'.
    reads = null

    // Assay-specific parameter namespace. Matches the structure already
    // established by config/demo.config (processed_results, study_id,
    // comparison_id), extended here with methylation-specific knobs used by
    // the raw-mode DMR-calling and annotation steps.
    methylation {
        processed_results = null
        study_id           = null
        comparison_id      = null

        // Raw-mode-only: CSV with header sample_id,treatment (treatment is
        // 0 = control/sham, 1 = treatment/exposed), used to build methylKit's
        // sample.id/treatment vectors in DMR_METHYLKIT.
        sample_sheet = null

        // Optional: unit of replication when treatment or phenotype is
        // assigned to a group of libraries (e.g. family). Names a column of
        // design_sheet (a TSV with run_accession or sample_id). Counts are
        // summed per unit and the test uses methylKit's overdispersion
        // correction, so the error comes from unit-to-unit variation.
        replicate_unit = null
        design_sheet   = null

        // Optional, dmr_engine = 'limma' only: design_sheet column naming
        // matched sets of units, e.g. the population that contributes one
        // resistant and one susceptible animal, or the animal sampled before
        // and after a challenge. The fit becomes ~ block + treatment (a
        // paired / randomized-block test). Every block needs both arms.
        block_by = null

        // Extra command-line options, recorded in the manifest. Bismark's
        // default --score_min L,0,-0.2 is strict for highly heterozygous
        // genomes: for M. gigas WGBS, L,0,-0.6 mapped 53.9% of pairs against
        // 15.5% (CIBNOR2021_HEAT_RRSS, 50k-pair test). extractor_args is where
        // M-bias trimming goes (e.g. --ignore_r2 N).
        bismark_align_args = ''
        extractor_args     = ''

        // Optional: split each trimmed library into chunks of this many read
        // pairs and align the chunks as separate tasks, then concatenate them
        // before deduplication (modules/methylation/bismark_chunked.nf). For
        // deep libraries on a scheduler with short or preemptible jobs, e.g.
        // 20000000 on Klone's ckpt partitions (-profile klone). null or 0
        // aligns each library as one task.
        align_chunk_pairs  = null

        // DMR engine. 'methylkit' (default) tests libraries, or pooled units,
        // with methylKit. 'limma' and 'dss' (modules/methylation/
        // dmr_pooled_tiles.nf) destrand CpGs, pool by replicate_unit, keep
        // CpGs at >= unit_min_coverage in every unit, and sum them into
        // tile_size tiles with >= tile_min_cpgs CpGs. 'limma' then fits a
        // moderated t on unit M-values, which stayed calibrated at 2 vs 2 units
        // in simulation; 'dss' uses DSS's Wald test, which did not. With
        // either, set min_coverage low (e.g. 1): coverage is then applied
        // after pooling, not per library.
        dmr_engine        = 'methylkit'
        // With 'limma' / 'dss': 'tiles' tests tile_size windows genome-wide;
        // 'genes' tests one unit per gene (all CpGs in its body and
        // promoter_upstream_bp promoter) plus tiles for intergenic CpGs. Use
        // 'genes' when results must be one record per gene, e.g. to pool or
        // link with RNA-seq evidence.
        dmr_features      = 'tiles'
        unit_min_coverage = 10
        tile_min_cpgs     = 10

        // Coverage filtering
        min_coverage = 10

        // DMR calling (methylKit)
        dmr_mode         = 'tile'   // 'tile' or 'base'
        tile_size        = 1000
        tile_step        = 1000
        qvalue_cutoff    = 0.05
        meth_diff_cutoff = 10.0

        // Annotation
        promoter_upstream_bp = 1500
    }
}

profiles {
    docker {
        docker.enabled       = true
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }

    local {
        docker.enabled    = false
        apptainer.enabled = false
        process.executor  = 'local'
    }

    demo {
        includeConfig '../../config/demo.config'
    }
}

manifest {
    name            = 'aree-methylation'
    author          = 'AREE contributors'
    description     = 'AREE DNA methylation / WGBS / EM-seq reanalysis and harmonization scaffold'
    mainScript      = 'main.nf'
    version         = '0.1.0-scaffold'
    nextflowVersion = '>=23.10.0'
}

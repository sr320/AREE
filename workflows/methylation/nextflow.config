// AREE methylation / WGBS / EM-seq workflow configuration
//
// STATUS: scaffold. Defines default params, container engine profiles, and
// includes the shared base config. Not tuned against a real run — see
// README.md "What has and has not been run".

includeConfig '../../config/base.config'

params {
    // 'raw_reanalysis' or 'processed_results_harmonization'. Default is the
    // mode that is actually runnable against the shipped demo data.
    mode = 'processed_results_harmonization'

    // Reference genome/annotation, used only in raw_reanalysis mode.
    genome_fasta     = null
    annotation_gtf   = null
    genome_assembly  = null

    // Paired-end bisulfite/EM-seq FASTQ glob, used only in raw_reanalysis
    // mode, e.g. 'data/raw/methylation/*_R{1,2}.fastq.gz'.
    reads = null

    // Assay-specific parameter namespace. Matches the structure already
    // established by config/demo.config (processed_results, study_id,
    // comparison_id), extended here with methylation-specific knobs used by
    // the raw-mode DMR-calling and annotation steps.
    methylation {
        processed_results = null
        study_id           = null
        comparison_id      = null

        // Raw-mode-only: CSV with header sample_id,treatment (treatment is
        // 0 = control/sham, 1 = treatment/exposed), used to build methylKit's
        // sample.id/treatment vectors in DMR_METHYLKIT.
        sample_sheet = null

        // Coverage filtering
        min_coverage = 10

        // DMR calling (methylKit)
        dmr_mode         = 'tile'   // 'tile' or 'base'
        tile_size        = 1000
        tile_step        = 1000
        qvalue_cutoff    = 0.05
        meth_diff_cutoff = 10.0

        // Annotation
        promoter_upstream_bp = 1500
    }
}

profiles {
    docker {
        docker.enabled       = true
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }

    local {
        docker.enabled    = false
        apptainer.enabled = false
        process.executor  = 'local'
    }

    demo {
        includeConfig '../../config/demo.config'
    }
}

manifest {
    name            = 'aree-methylation'
    author          = 'AREE contributors'
    description     = 'AREE DNA methylation / WGBS / EM-seq reanalysis and harmonization scaffold'
    mainScript      = 'main.nf'
    version         = '0.1.0-scaffold'
    nextflowVersion = '>=23.10.0'
}

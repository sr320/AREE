// AREE proteomics workflow configuration
//
// STATUS: scaffold. Wires shared base.config, container-engine profiles, and
// this workflow's own params (mode + per-mode input paths). Not executed
// against real data in this build -- see README.md "What has and has not
// been run".

includeConfig '../../config/base.config'

params {
    // 'raw_reanalysis'                 : start from a raw/wide protein
    //                                    abundance matrix (proteins x
    //                                    samples) -- see README.md for the
    //                                    explicit definition of "raw" used
    //                                    here (NOT raw mass-spec spectra).
    // 'processed_results_harmonization': start from an already-shaped
    //                                    protein-level differential
    //                                    abundance table.
    mode = 'processed_results_harmonization'

    proteomics {
        study_id       = null
        comparison_id  = null

        // raw_reanalysis mode inputs
        raw_abundance_matrix = null   // wide TSV/CSV: protein_accession + one column per sample
        sample_sheet          = null   // TSV/CSV: sample_id, group (+ optional metadata columns)
        id_mapping_table       = "${projectDir}/../../data/mappings/gene_id_crosswalk.tsv"

        // processed_results_harmonization mode input
        processed_results = null      // already-shaped protein-level DE-like table
    }

    outdir = 'results/proteomics'
}

profiles {
    docker {
        docker.enabled     = true
        apptainer.enabled  = false
        conda.enabled      = false
    }

    apptainer {
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        docker.enabled         = false
        conda.enabled          = false
    }

    local {
        // No container engine -- assumes tools are available on PATH.
        // Intended for stub-run / dev use only; not recommended for the R
        // (limma) step given dependency complexity.
        docker.enabled     = false
        apptainer.enabled  = false
        conda.enabled      = false
    }

    demo {
        includeConfig '../../config/demo.config'
    }

    stub {
        // Convenience profile for `nextflow run main.nf -profile stub -stub-run`
        // to exercise the DAG without any container engine or real tools.
        docker.enabled     = false
        apptainer.enabled  = false
    }
}

manifest {
    name            = 'aree-proteomics'
    author          = 'AREE contributors'
    description     = 'AREE proteomics reanalysis / harmonization workflow scaffold'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0-scaffold'
}

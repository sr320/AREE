// AREE metabolomics workflow configuration
//
// STATUS: scaffold, unexecuted in this build (see README.md). Pulls in
// shared resourcing/reporting defaults from config/base.config and defines
// the metabolomics-specific params.* namespace consumed by main.nf and
// modules/metabolomics/*.nf.
//
// Typical invocations:
//   nextflow run workflows/metabolomics/main.nf -profile docker \
//     -params-file ../../config/demo.config
//     # (or) -c ../../config/demo.config
//
//   nextflow run workflows/metabolomics/main.nf -profile docker \
//     --mode raw_reanalysis \
//     --metabolomics.raw_feature_table path/to/features.tsv \
//     --metabolomics.sample_sheet path/to/samples.tsv \
//     --metabolomics.study_id STUDY_ID \
//     --metabolomics.comparison_id treatment_vs_control

includeConfig '../../config/base.config'

params {
    // 'raw_reanalysis' | 'processed_results_harmonization'
    mode = 'processed_results_harmonization'

    metabolomics {
        // --- processed_results_harmonization mode ---
        // Already-shaped differential feature table (feature_id,
        // putative_metabolite_name, annotation_confidence_level,
        // metabolite_class, log2FC, pvalue, padj) or a close variant that
        // STANDARDIZE_OUTPUT can coerce into that shape.
        processed_results = null

        // --- raw_reanalysis mode ---
        // Raw/unfiltered feature-by-sample intensity table (XCMS/MZmine-style
        // export). NOT raw mzML — see README.md "Two modes".
        raw_feature_table = null
        // Sample sheet: sample_id, condition (control/treatment)[, qc_pool]
        sample_sheet = null
        // Optional TSV: feature_id, putative_metabolite_name,
        // annotation_confidence_level. If null, only confidence values
        // already present in raw_feature_table are used; anything else
        // defaults to level 4 (unknown).
        metabolite_annotation_map = null
        // Optional TSV: putative_metabolite_name, metabolite_class[, pathway].
        // If null, all features fall back to metabolite_class "unknown".
        metabolite_class_map = null
        // Coefficient-of-variation threshold for pooled-QC-sample QC metric.
        qc_cv_threshold = 0.30

        // Identifiers threaded through every process/output filename and
        // into the provenance manifest. Overridden by config/demo.config in
        // the demo run.
        study_id      = 'STUDY_ID'
        comparison_id = 'comparison_id'
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        // Apptainer can pull Docker Hub / quay.io / ghcr.io images directly
        // via the docker:// URI scheme; process `container` directives are
        // reused unchanged. Not tested against a real Apptainer install in
        // this build (see containers/README.md).
    }

    local {
        // No containerization; assumes tools (python3, pandas, R/limma,
        // quarto) are already available on PATH. Useful for local debugging
        // of process script: blocks only — not the intended execution mode.
        docker.enabled     = false
        apptainer.enabled  = false
    }

    demo {
        includeConfig '../../config/demo.config'
    }
}
